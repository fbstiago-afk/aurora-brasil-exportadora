	partition fMetas = m
		mode: import
		source =
				let
                    Origem = Csv.Document(
                        File.Contents(pBasePath & "fMetas.csv"),
                        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                    ),
                    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
                    TiposAplicados = Table.TransformColumnTypes(
                        CabecalhoPromovido,
                        {{"Data", type date},{"Ano", Int64.Type},{"Mes", Int64.Type},{"AnoMes", type text},{"AnoMesNumero", Int64.Type},{"VendedorID", Int64.Type},{"Regiao", type text},{"MetaReceitaUSD", type number},{"MetaVolumeKg", type number},{"MetaMargemUSD", type number},{"MetaNovosClientes", Int64.Type},{"MetaPedidos", Int64.Type}},
                        "pt-BR"
                    ),
                    ErrosRemovidos = Table.RemoveRowsWithErrors(TiposAplicados)
                in
                    ErrosRemovidos

	annotation PBI_ResultType = Table
