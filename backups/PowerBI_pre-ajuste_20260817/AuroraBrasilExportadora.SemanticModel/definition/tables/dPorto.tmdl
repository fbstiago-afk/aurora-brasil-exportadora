table dPorto
	/// Dimensao de portos e aeroportos de origem e destino (UN/LOCODE).
	lineageTag: 4fd993cd-67bf-c833-795f-375efbfc414b

	column PortoID
		dataType: int64
		formatString: #,0
		isHidden
		lineageTag: d3693ec7-fad7-02d7-256c-3da622c8fc72
		summarizeBy: none
		sourceColumn: PortoID

		annotation SummarizationSetBy = Automatic

	column Porto
		dataType: string
		lineageTag: 5022d468-4b4f-19c6-445d-3c5e0b3afe67
		summarizeBy: none
		sourceColumn: Porto

		annotation SummarizationSetBy = Automatic

	column Cidade
		dataType: string
		lineageTag: a2b86621-91a5-044c-a86e-5afb4c00b1c3
		summarizeBy: none
		sourceColumn: Cidade

		annotation SummarizationSetBy = Automatic

	column Pais
		dataType: string
		lineageTag: 61c8a16a-f644-f286-c0a3-9743c2dcc5c8
		summarizeBy: none
		sourceColumn: Pais

		annotation SummarizationSetBy = Automatic

	column CodigoUNLOCODE
		dataType: string
		lineageTag: 23225cb3-44b7-2793-a644-a517a33b351e
		summarizeBy: none
		sourceColumn: CodigoUNLOCODE

		annotation SummarizationSetBy = Automatic

	column TipoPorto
		dataType: string
		lineageTag: 583d95cf-7d73-f3de-3631-f4f906098ed1
		summarizeBy: none
		sourceColumn: TipoPorto

		annotation SummarizationSetBy = Automatic

	partition dPorto = m
		mode: import
		source =
				let
                    Origem = Csv.Document(
                        File.Contents(pBasePath & "dPorto.csv"),
                        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                    ),
                    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
                    TiposAplicados = Table.TransformColumnTypes(
                        CabecalhoPromovido,
                        {{"PortoID", Int64.Type},{"Porto", type text},{"Cidade", type text},{"Pais", type text},{"CodigoUNLOCODE", type text},{"TipoPorto", type text}},
                        "pt-BR"
                    ),
                    ErrosRemovidos = Table.RemoveRowsWithErrors(TiposAplicados)
                in
                    ErrosRemovidos

	annotation PBI_ResultType = Table
