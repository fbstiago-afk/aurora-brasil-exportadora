	partition fRecebimentos = m
		mode: import
		source =
				let
                    Origem = Csv.Document(
                        File.Contents(pBasePath & "fRecebimentos.csv"),
                        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                    ),
                    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
                    TiposAplicados = Table.TransformColumnTypes(
                        CabecalhoPromovido,
                        {{"RecebimentoID", Int64.Type},{"Invoice", type text},{"ClienteID", Int64.Type},{"DataFaturamento", type date},{"DataVencimento", type date},{"DataPagamento", type date},{"ValorUSD", type number},{"ValorRecebidoUSD", type number},{"SaldoUSD", type number},{"Status", type text},{"DiasAtraso", Int64.Type},{"FormaPagamento", type text}},
                        "pt-BR"
                    ),
                    ErrosRemovidos = Table.RemoveRowsWithErrors(TiposAplicados)
                in
                    ErrosRemovidos

	annotation PBI_ResultType = Table
