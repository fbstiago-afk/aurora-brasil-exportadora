		lineageTag: 96edc7be-a1bd-1070-1b20-aec735ea9252

	measure 'Receita YTD' = TOTALYTD([Receita USD], dCalendario[Data])
		formatString: "US$ "#,0.00
		displayFolder: 02 Crescimento
		lineageTag: 804a2393-0d7f-b1ed-b37d-718ce9c08fe9

	measure 'Receita YTD LY' = CALCULATE([Receita YTD], SAMEPERIODLASTYEAR(dCalendario[Data]))
		formatString: "US$ "#,0.00
		displayFolder: 02 Crescimento
		lineageTag: aafdc414-cc95-ae18-2cb6-b1ec69227e8a

	measure 'Receita YTD YoY %' = DIVIDE([Receita YTD] - [Receita YTD LY], [Receita YTD LY])
		formatString: #,0.0 %
