	measure 'Status Meta' =
			VAR _A = [Atingimento %]
			RETURN SWITCH(TRUE(), ISBLANK(_A), BLANK(), _A >= 1.2, "Superado", _A >= 1, "Atingido",
			    _A >= 0.9, "Proximo", _A >= 0.8, "Abaixo", "Muito abaixo")
		displayFolder: 09 Metas
