		displayFolder: 02 Crescimento
		lineageTag: ad59b387-1951-f144-081f-56268a5549b1

	measure 'Receita PM' = CALCULATE([Receita USD], DATEADD(dCalendario[Data], -1, MONTH))
		formatString: "US$ "#,0.00
		displayFolder: 02 Crescimento
		lineageTag: a02e4f24-922e-3673-f31b-52ec03b5c3cb

	measure 'Receita MoM' = [Receita USD] - [Receita PM]
