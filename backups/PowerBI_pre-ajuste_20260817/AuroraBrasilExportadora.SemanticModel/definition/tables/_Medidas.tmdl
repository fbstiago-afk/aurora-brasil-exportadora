		lineageTag: 84f85780-0e3f-eada-fec3-cf8c18c6284f

	measure 'Linhas de Pedido' = COUNTROWS(fVendas)
		formatString: #,0
		displayFolder: 03 Volume
		lineageTag: d3f37665-66a8-aed7-af9a-49aa4fee2aba

	measure 'Ticket Medio USD' = DIVIDE([Receita USD], [Pedidos])
		formatString: "US$ "#,0.00
		displayFolder: 03 Volume
		lineageTag: 1655655d-a86c-4b76-6abc-5f23c44f57fc

	measure 'Ticket Medio BRL' = DIVIDE([Receita BRL], [Pedidos])
		formatString: "R$ "#,0.00
		displayFolder: 03 Volume
		lineageTag: 1ec7eec9-083f-fb41-77cf-c2102c2e0055

	measure 'Preco Medio por Kg' = DIVIDE([Receita Bruta USD], [Peso Total Kg])
		formatString: "US$ "#,0.00
		displayFolder: 03 Volume
