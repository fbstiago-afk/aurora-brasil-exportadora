		lineageTag: e9103b86-d0de-f47d-79e1-19122f1126cf

	measure 'Receita Rolling 3M' = CALCULATE([Receita USD], DATESINPERIOD(dCalendario[Data], MAX(dCalendario[Data]), -3, MONTH))
		formatString: "US$ "#,0.00
		displayFolder: 02 Crescimento
		lineageTag: 278dc623-a9ad-040f-e376-39a1bd8fe8db

	measure 'Receita Rolling 6M' = CALCULATE([Receita USD], DATESINPERIOD(dCalendario[Data], MAX(dCalendario[Data]), -6, MONTH))
		formatString: "US$ "#,0.00
		displayFolder: 02 Crescimento
		lineageTag: 99fc4a4c-cb23-18bc-f588-2514f7744926

	measure 'Receita Rolling 12M' = CALCULATE([Receita USD], DATESINPERIOD(dCalendario[Data], MAX(dCalendario[Data]), -12, MONTH))
		formatString: "US$ "#,0.00
		displayFolder: 02 Crescimento
		lineageTag: fcbf684a-efc5-b396-9c14-11c5ad46e3dd

	measure 'Receita Media Mensal 12M' = DIVIDE([Receita Rolling 12M], 12)
		formatString: "US$ "#,0.00
		displayFolder: 02 Crescimento
		lineageTag: cdfe2189-b648-cf5c-6fad-b86e3cb441d6

	measure 'CAGR Receita' =
			VAR _Ini = CALCULATE([Receita USD], ALL(dCalendario), dCalendario[Ano] = MIN(dCalendario[Ano]))
			VAR _Fim = CALCULATE([Receita USD], ALL(dCalendario), dCalendario[Ano] = MAX(dCalendario[Ano]))
			VAR _N = MAX(dCalendario[Ano]) - MIN(dCalendario[Ano])
			RETURN IF(_N > 0 && _Ini > 0, ( _Fim / _Ini ) ^ DIVIDE(1, _N) - 1)
		formatString: #,0.0 %
		displayFolder: 02 Crescimento
		lineageTag: 28bdbf3d-9230-37bf-e906-3c4be20a8035

	/// Variacao da margem percentual em pontos percentuais versus ano anterior.
	measure 'Margem YoY p.p.' = [Margem Bruta %] - CALCULATE([Margem Bruta %], SAMEPERIODLASTYEAR(dCalendario[Data]))
		formatString: #,0.0
		displayFolder: 02 Crescimento
		lineageTag: bcc5fd18-9c21-b483-de78-b8ce1462d4de

	measure 'Volume YoY %' =
			VAR _LY = CALCULATE([Peso Total Kg], SAMEPERIODLASTYEAR(dCalendario[Data]))
			RETURN DIVIDE([Peso Total Kg] - _LY, _LY)
		formatString: #,0.0 %
		displayFolder: 02 Crescimento
		lineageTag: 56337ee6-56b7-e770-8fd4-5b5127b0b004

	measure 'Quantidade' = SUM(fVendas[Quantidade])
		formatString: #,0
		displayFolder: 03 Volume
		lineageTag: 85f2e638-d6cb-71e3-1790-df1efe241a9d

	measure 'Peso Total Kg' = SUM(fVendas[PesoTotalKg])
