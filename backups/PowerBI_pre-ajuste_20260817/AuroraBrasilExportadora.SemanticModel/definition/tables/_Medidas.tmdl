	measure 'Contas a Receber' = SUM(fRecebimentos[ValorUSD])
		formatString: "US$ "#,0.00
		displayFolder: 12 Financeiro
		lineageTag: e6641b9f-44a1-3bfd-52c4-42256ab0a2f6

	measure 'Recebido USD' = SUM(fRecebimentos[ValorRecebidoUSD])
		formatString: "US$ "#,0.00
		displayFolder: 12 Financeiro
		lineageTag: 80da33de-a7f5-476d-3d44-f2c909825f2d

	measure 'Saldo em Aberto' = SUM(fRecebimentos[SaldoUSD])
		formatString: "US$ "#,0.00
		displayFolder: 12 Financeiro
		lineageTag: 93e93c8f-6c31-b57e-bd3d-9b71031f4fee

	measure 'Saldo Vencido' = CALCULATE([Saldo em Aberto], fRecebimentos[Status] IN {"Vencido", "Parcial"})
		formatString: "US$ "#,0.00
		displayFolder: 12 Financeiro
		lineageTag: b0373803-bd8e-d645-32cf-3b0987e2c1f3

	measure 'Inadimplencia %' = DIVIDE([Saldo Vencido], [Contas a Receber])
		formatString: #,0.0 %
		displayFolder: 12 Financeiro
		lineageTag: 38f109c5-bd9f-9c0a-af92-46a21a54224a

	measure 'Dias Medios de Atraso' = CALCULATE(AVERAGE(fRecebimentos[DiasAtraso]), fRecebimentos[DiasAtraso] > 0)
		formatString: #,0.0
		displayFolder: 12 Financeiro
		lineageTag: e24aa959-d5fc-e659-4530-b5896537c8a4

	/// PMR em dias entre faturamento e pagamento efetivo.
	measure 'Prazo Medio Recebimento' =
			AVERAGEX(FILTER(fRecebimentos, NOT ISBLANK(fRecebimentos[DataPagamento])),
			    DATEDIFF(fRecebimentos[DataFaturamento], fRecebimentos[DataPagamento], DAY))
		formatString: #,0.0
		displayFolder: 12 Financeiro
		lineageTag: 9654007a-c129-68f4-a982-0c0b663bae23

	measure 'Faixa Aging' =
			VAR _Hoje = MAX(dCalendario[Data])
			VAR _D = AVERAGEX(fRecebimentos, DATEDIFF(fRecebimentos[DataVencimento], _Hoje, DAY))
			RETURN SWITCH(TRUE(), _D < 0, "A vencer", _D <= 30, "1-30 dias", _D <= 60, "31-60 dias",
			    _D <= 90, "61-90 dias", _D <= 180, "91-180 dias", "+180 dias")
		displayFolder: 12 Financeiro
		lineageTag: 1ea6b9fc-d5be-afaa-00b6-bad5fe462845

	measure 'Saldo Vencido +90' =
			VAR _Hoje = MAX(dCalendario[Data])
			RETURN CALCULATE([Saldo em Aberto],
			    FILTER(fRecebimentos, DATEDIFF(fRecebimentos[DataVencimento], _Hoje, DAY) > 90))
		formatString: "US$ "#,0.00
		displayFolder: 12 Financeiro
		lineageTag: fc02bdd7-8482-db3d-6149-a6fd1498fc02

	measure 'Taxa Media USD BRL' = CALCULATE(AVERAGE(fCambio[TaxaBRL]), fCambio[Moeda] = "USD")
		formatString: #,0.0000
		displayFolder: 13 Cambio
		lineageTag: 3b2fe259-c7c5-1b63-deb4-18fdb351d085

	measure 'Taxa Media Ponderada' = DIVIDE([Receita BRL], [Receita USD])
		formatString: #,0.0000
		displayFolder: 13 Cambio
		lineageTag: ebb215f2-3320-363e-71c0-4478d07cba87

	measure 'Taxa Media LY' = CALCULATE([Taxa Media Ponderada], SAMEPERIODLASTYEAR(dCalendario[Data]))
		formatString: #,0.0000
		displayFolder: 13 Cambio
		lineageTag: 256372ff-950a-d2cd-c691-199b4ee5d756

	/// Parcela da variacao da receita em BRL explicada apenas pela variacao cambial.
	measure 'Efeito Cambio BRL' = [Receita USD] * ([Taxa Media Ponderada] - [Taxa Media LY])
		formatString: "R$ "#,0.00
		displayFolder: 13 Cambio
		lineageTag: c1266da2-adbf-54ca-3d8c-57122d515560

	measure 'Crescimento Operacional BRL' =
			VAR _LY_BRL = CALCULATE([Receita BRL], SAMEPERIODLASTYEAR(dCalendario[Data]))
			RETURN [Receita BRL] - _LY_BRL - [Efeito Cambio BRL]
		formatString: "R$ "#,0.00
		displayFolder: 13 Cambio
		lineageTag: 5ccffc0b-2089-122d-9370-32690c82c30e

	measure 'Variacao Cambial %' = DIVIDE([Taxa Media Ponderada] - [Taxa Media LY], [Taxa Media LY])
		formatString: #,0.0 %
		displayFolder: 13 Cambio
		lineageTag: a1f079d6-1153-d1a6-563d-9eb11d771e40

	/// Quanto o elemento explica da variacao total de receita do periodo.
	measure 'Contribuicao para Crescimento' = DIVIDE([Receita YoY], CALCULATE([Receita YoY], ALLSELECTED()))
		formatString: #,0.0 %
		displayFolder: 14 Inteligencia Comercial
		lineageTag: 8166ece1-847a-3984-78e3-65e0f33bd63b

	measure 'Maior Crescimento Mercado' =
			VAR _T = TOPN(1, ALLSELECTED(dPais[Pais]), [Receita YoY], DESC)
			RETURN CONCATENATEX(_T, dPais[Pais], ", ")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: eb1860b2-dc20-ee4c-a4ed-e2e6453591e2

	measure 'Maior Queda Mercado' =
			VAR _T = TOPN(1, ALLSELECTED(dPais[Pais]), [Receita YoY], ASC)
			RETURN CONCATENATEX(_T, dPais[Pais], ", ")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: bd3db621-64d5-32b4-9c7d-29d37d37c92f
	/// Texto dinamico com sustentacao matematica para a area de insights.

	measure 'Cliente Maior Queda' =
			VAR _T = TOPN(1, ALLSELECTED(dCliente[RazaoSocial]), [Receita YoY], ASC)
			RETURN CONCATENATEX(_T, dCliente[RazaoSocial], ", ")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: 954d9073-1f9f-9613-c827-95a1d90206b5

	measure 'Texto Insight Crescimento' =
			VAR _Total = CALCULATE([Receita YoY], ALLSELECTED(dPais))
			VAR _TopPais = TOPN(1, ALLSELECTED(dPais[Pais]), [Receita YoY], DESC)
			VAR _Nome = CONCATENATEX(_TopPais, dPais[Pais], ", ")
			VAR _Val = MAXX(_TopPais, [Receita YoY])
			VAR _Part = DIVIDE(_Val, _Total)
			RETURN IF(ISBLANK(_Total) || _Total = 0, "Sem base comparativa no periodo selecionado.",
			    _Nome & " respondeu por " & FORMAT(_Part, "0.0%") & " da variacao de receita do periodo ("
			    & FORMAT(_Val, "$#,0,,.0M") & ").")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: 0b5dafda-f6c0-8b13-c643-64b614055858

	measure 'Texto Insight Margem' =
			VAR _pp = [Margem YoY p.p.]
			RETURN IF(ISBLANK(_pp), "Sem comparativo YoY.",
			    "Margem bruta " & IF(_pp >= 0, "avancou ", "recuou ") & FORMAT(ABS(_pp), "0.0")
			    & " p.p. YoY, hoje em " & FORMAT([Margem Bruta %], "0.0%") & ".")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: 9beb50e3-181c-674d-a3b9-63c0552a1aea

	measure 'Alerta Rota Critica' =
			VAR _T = TOPN(1, ALLSELECTED(dPais[Pais]), [% Embarques Atrasados], DESC)
			VAR _Nome = CONCATENATEX(_T, dPais[Pais], ", ")
			VAR _V = MAXX(_T, [% Embarques Atrasados])
			RETURN IF(ISBLANK(_V), BLANK(), _Nome & ": " & FORMAT(_V, "0.0%") & " de entregas atrasadas")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: 655fbb56-28a1-253e-4580-e419fdf47133

	measure 'Cor Semaforo Meta' =
			VAR _A = [Atingimento %]
			RETURN SWITCH(TRUE(), ISBLANK(_A), "#8C96A5", _A >= 1, "#1F8A70", _A >= 0.9, "#D9A441", "#C0453B")
		displayFolder: 15 Formatacao
		lineageTag: d42b2a0f-5de6-0f54-7a65-d8dde50e5c6d

	measure 'Cor Variacao' = IF([Receita YoY] >= 0, "#1F8A70", "#C0453B")
		displayFolder: 15 Formatacao
		lineageTag: 2005db7e-b251-d77b-3515-6a72fdd81a28

	measure 'Icone Tendencia' = IF([Receita YoY] >= 0, "▲", "▼")
		displayFolder: 15 Formatacao
		lineageTag: 9df5abbc-dd69-8bed-cfd1-214682f0ee08

	measure 'KPI Receita Contexto' =
			IF(ISBLANK([Receita LY]), "sem comparativo",
			    [Icone Tendencia] & " " & FORMAT([Receita YoY %], "0.0%") & " YoY  ("
			    & FORMAT([Receita YoY], "$#,0,,.1M") & ")")
		displayFolder: 15 Formatacao
		lineageTag: f6cec6ce-9ed4-71ba-bf32-1ed272572fd0

	measure 'Titulo Periodo' =
			VAR _Ini = MIN(dCalendario[Data]) VAR _Fim = MAX(dCalendario[Data])
			RETURN IF(YEAR(_Ini) = YEAR(_Fim) && MONTH(_Ini) = MONTH(_Fim),
			    FORMAT(_Ini, "mmm/yyyy"),
			    FORMAT(_Ini, "mmm/yy") & " - " & FORMAT(_Fim, "mmm/yy"))
		displayFolder: 16 Titulos Dinamicos
		lineageTag: 52e85429-ef5e-98a3-76ed-53287351c3c0

	measure 'Titulo Filtros' =
			VAR _Cont = IF(ISFILTERED(dPais[Continente]),
			        CONCATENATEX(VALUES(dPais[Continente]), dPais[Continente], ", "), "Global")
			RETURN _Cont & " — " & [Titulo Periodo]
		displayFolder: 16 Titulos Dinamicos
		lineageTag: 6e0a86f0-4093-7e09-913b-176cf26306d6

	measure 'Titulo Receita por Pais' = "Receita por Pais — " & [Titulo Filtros]
		displayFolder: 16 Titulos Dinamicos
		lineageTag: abd8b332-bebc-f72e-dcf8-2f36dce9f624

	measure 'Titulo Performance Comercial' = "Performance Comercial — " & [Titulo Filtros]
		displayFolder: 16 Titulos Dinamicos
		lineageTag: c649fb8a-e844-b574-c85e-e1a99c018b4f

	measure 'Titulo Rentabilidade' = "Ponte de Rentabilidade — " & [Titulo Periodo]
		displayFolder: 16 Titulos Dinamicos
		lineageTag: 2462fbfa-ac4c-0629-26e5-5db35b607c00

	column Coluna
		dataType: int64
		isHidden
		lineageTag: ed88568b-d4a7-376b-4dab-eeb8e1a81228
		summarizeBy: none
		sourceColumn: Coluna

	partition _Medidas = m
		mode: import
		source =
				let
				    Origem = #table(type table [Coluna = Int64.Type], {{1}})
				in
				    Origem

	annotation PBI_ResultType = Table
