		lineageTag: 825447b6-7ac1-4f67-3edc-c94e55230493

	measure 'Impacto Desconto %' = DIVIDE([Descontos USD], [Receita Bruta USD])
		formatString: #,0.0 %
		displayFolder: 04 Margem
		lineageTag: f3742512-c3d9-4c07-71aa-27fa207f9a6c

	measure 'Margem LY' = CALCULATE([Margem Bruta USD], SAMEPERIODLASTYEAR(dCalendario[Data]))
		formatString: "US$ "#,0.00
		displayFolder: 04 Margem
		lineageTag: 8e8b3854-9695-6605-02fb-a590b7775234

	measure 'Margem YoY %' = DIVIDE([Margem Bruta USD] - [Margem LY], [Margem LY])
		formatString: #,0.0 %
		displayFolder: 04 Margem
		lineageTag: 5eb9f254-ae76-91be-0c2c-ec6850a72472

	measure 'Margem YTD' = TOTALYTD([Margem Bruta USD], dCalendario[Data])
		formatString: "US$ "#,0.00
		displayFolder: 04 Margem
		lineageTag: f1a2dce2-c73f-8026-0b2e-f89bc9d89038

	/// Clientes com ao menos um faturamento no contexto de filtro.
	measure 'Clientes Ativos' = CALCULATE(DISTINCTCOUNT(fVendas[ClienteID]), fVendas[StatusPedido] = "Faturado")
		formatString: #,0
		displayFolder: 05 Clientes
		lineageTag: 8be7dbd2-f92f-c301-a810-badd0d2f974e

	measure 'Clientes 90D' =
			VAR _Fim = MAX(dCalendario[Data])
			RETURN CALCULATE(DISTINCTCOUNT(fVendas[ClienteID]),
			    DATESINPERIOD(dCalendario[Data], _Fim, -90, DAY), ALL(dCalendario))
		formatString: #,0
		displayFolder: 05 Clientes
		lineageTag: 1e72b1d9-295d-88bc-750c-b56153a48338

	measure 'Clientes Base' = COUNTROWS(dCliente)
		formatString: #,0
	/// Clientes cuja primeira compra historica ocorreu dentro do periodo filtrado.
		displayFolder: 05 Clientes
		lineageTag: 9de98f1b-8e37-8f42-c42c-de21d4e63a7f

	measure 'Novos Clientes' =
			VAR _Ini = MIN(dCalendario[Data])
			VAR _Fim = MAX(dCalendario[Data])
			RETURN COUNTROWS(FILTER(VALUES(dCliente[ClienteID]),
			    VAR _Prim = CALCULATE(MIN(fVendas[DataFaturamento]), ALL(dCalendario))
			    RETURN NOT ISBLANK(_Prim) && _Prim >= _Ini && _Prim <= _Fim))
		formatString: #,0
		displayFolder: 05 Clientes
	/// Sem compras nos ultimos 365 dias em relacao ao fim do periodo.
		lineageTag: 869a54c2-b4b4-eba4-fa9d-1300c1a32949

	measure 'Clientes Perdidos' =
			VAR _Fim = MAX(dCalendario[Data])
			RETURN COUNTROWS(FILTER(VALUES(dCliente[ClienteID]),
			    VAR _Ult = CALCULATE(MAX(fVendas[DataFaturamento]), ALL(dCalendario), dCalendario[Data] <= _Fim)
			    RETURN NOT ISBLANK(_Ult) && _Ult < _Fim - 365))
		formatString: #,0
		displayFolder: 05 Clientes
		lineageTag: bad75d42-c624-ac22-56a8-87f2235b5f66

	measure 'Clientes Em Risco' =
			VAR _Fim = MAX(dCalendario[Data])
			RETURN COUNTROWS(FILTER(VALUES(dCliente[ClienteID]),
			    VAR _Ult = CALCULATE(MAX(fVendas[DataFaturamento]), ALL(dCalendario), dCalendario[Data] <= _Fim)
			    RETURN NOT ISBLANK(_Ult) && _Ult < _Fim - 180 && _Ult >= _Fim - 365))
		formatString: #,0
		displayFolder: 05 Clientes
		lineageTag: c08fa15b-b754-92c5-b6c0-19a4764c58c1

	measure 'Clientes Inativos 90D' =
			VAR _Fim = MAX(dCalendario[Data])
			RETURN COUNTROWS(FILTER(VALUES(dCliente[ClienteID]),
			    VAR _Ult = CALCULATE(MAX(fVendas[DataFaturamento]), ALL(dCalendario), dCalendario[Data] <= _Fim)
			    RETURN NOT ISBLANK(_Ult) && _Ult < _Fim - 90))
	/// Comprou no periodo apos 180 dias ou mais sem compras.
		formatString: #,0
		displayFolder: 05 Clientes
		lineageTag: 0733c4ac-d8a7-50bd-de19-ad2382472c9d

	measure 'Clientes Reativados' =
			VAR _Ini = MIN(dCalendario[Data])
			VAR _Fim = MAX(dCalendario[Data])
			RETURN COUNTROWS(FILTER(VALUES(dCliente[ClienteID]),
			    VAR _Comprou = CALCULATE([Pedidos]) > 0
			    VAR _Ant = CALCULATE(MAX(fVendas[DataFaturamento]), ALL(dCalendario), dCalendario[Data] < _Ini)
			    RETURN _Comprou && NOT ISBLANK(_Ant) && _Ant < _Ini - 180))
		formatString: #,0
		displayFolder: 05 Clientes
		lineageTag: 05958ad7-17d4-639e-a696-123ea33f5100

	measure 'Taxa de Churn %' = DIVIDE([Clientes Perdidos], [Clientes Perdidos] + [Clientes Ativos])
		formatString: #,0.0 %
		displayFolder: 05 Clientes
		lineageTag: 270b9115-c32f-7bc6-5733-3bf1be3b37ee

	measure 'Receita em Risco' =
			VAR _Fim = MAX(dCalendario[Data])
			RETURN SUMX(FILTER(VALUES(dCliente[ClienteID]),
			    VAR _Ult = CALCULATE(MAX(fVendas[DataFaturamento]), ALL(dCalendario), dCalendario[Data] <= _Fim)
			    RETURN NOT ISBLANK(_Ult) && _Ult < _Fim - 180),
			    CALCULATE([Receita Rolling 12M]))
		formatString: "US$ "#,0.00
		displayFolder: 05 Clientes
		lineageTag: 82c6958d-021a-0e7c-0885-d1266d1a9511

	measure 'Receita por Cliente' = DIVIDE([Receita USD], [Clientes Ativos])
		formatString: "US$ "#,0.00
		displayFolder: 05 Clientes
		lineageTag: 1c7be654-be28-7121-190c-fe972ff93eb0

	measure 'Frequencia Media' = DIVIDE([Pedidos], [Clientes Ativos])
		formatString: #,0.0
		displayFolder: 05 Clientes
		lineageTag: 87541eda-5ff0-8a3b-c127-1a5ba3876301

	measure 'Recencia Dias' = DATEDIFF(CALCULATE(MAX(fVendas[DataFaturamento])), MAX(dCalendario[Data]), DAY)
		formatString: #,0
		displayFolder: 05 Clientes
		lineageTag: ae017640-a641-ee5a-a873-6183a54f5534

	measure 'Recencia Media Dias' = AVERAGEX(VALUES(dCliente[ClienteID]), [Recencia Dias])
		formatString: #,0.0
		displayFolder: 05 Clientes
		lineageTag: f6824f34-6037-db94-9b07-d5de9dcd8e16

	measure 'Data Primeira Compra' = CALCULATE(MIN(fVendas[DataFaturamento]), ALL(dCalendario))
		formatString: yyyy-mm-dd
		displayFolder: 05 Clientes
		lineageTag: f7b21577-37dd-9766-eec5-c1b82a37c77a

	measure 'Data Ultima Compra' = CALCULATE(MAX(fVendas[DataFaturamento]))
		formatString: yyyy-mm-dd
		displayFolder: 05 Clientes
		lineageTag: 3057a655-f611-e3ec-a9df-1999aa7fce14

	/// Proxy de valor vitalicio: receita 12M projetada em 3 anos ponderada pela margem.
	measure 'LTV Estimado' = [Receita Rolling 12M] * 3 * [Margem Bruta %]
		formatString: "US$ "#,0.00
		displayFolder: 05 Clientes
		lineageTag: fa52fa35-26af-ac35-ab7d-a54ae12ef8f8

	measure 'Score Recencia' =
			VAR _R = [Recencia Dias]
			RETURN SWITCH(TRUE(), ISBLANK(_R), BLANK(), _R <= 45, 5, _R <= 90, 4, _R <= 180, 3, _R <= 365, 2, 1)
		formatString: #,0
		displayFolder: 06 RFV
		lineageTag: 75f270a3-3a5b-9144-26de-5eb578109d92

	measure 'Score Frequencia' =
			VAR _F = [Pedidos]
			RETURN SWITCH(TRUE(), _F = 0, BLANK(), _F >= 40, 5, _F >= 20, 4, _F >= 10, 3, _F >= 4, 2, 1)
		formatString: #,0
		displayFolder: 06 RFV
		lineageTag: 6c9b2100-e95a-81a7-026a-2fb74c6a5205

	/// Classificacao RFV dinamica calculada no contexto do relatorio.
	measure 'Score Valor' =
			VAR _V = [Receita USD]
			VAR _Rk = RANKX(ALLSELECTED(dCliente[ClienteID]), [Receita USD], , DESC)
			VAR _N = COUNTROWS(ALLSELECTED(dCliente[ClienteID]))
			VAR _P = DIVIDE(_Rk, _N)
			RETURN IF(ISBLANK(_V), BLANK(), SWITCH(TRUE(), _P <= 0.1, 5, _P <= 0.3, 4, _P <= 0.6, 3, _P <= 0.85, 2, 1))
		formatString: #,0
		displayFolder: 06 RFV
		lineageTag: 1b35edc1-c6c6-229f-204c-e59757c6bd11

	measure 'Score RFV Total' = [Score Recencia] + [Score Frequencia] + [Score Valor]
		formatString: #,0
		displayFolder: 06 RFV
		lineageTag: 4d9b7295-440b-5bff-4b69-f885b81d598d

	measure 'Segmento RFV' =
			VAR _R = [Score Recencia] VAR _F = [Score Frequencia] VAR _V = [Score Valor]
			VAR _Prim = [Data Primeira Compra]
			VAR _Novo = DATEDIFF(_Prim, MAX(dCalendario[Data]), DAY) <= 180
			RETURN SWITCH(TRUE(),
			    ISBLANK(_R), "Sem historico",
			    _R >= 4 && _F >= 4 && _V >= 4, "Campeoes",
			    _R >= 3 && _F >= 3 && _V >= 3, "Leais",
			    _Novo && _R >= 4, "Novos",
			    _R >= 4 && _F <= 2, "Potenciais",
			    _R = 3 && _F >= 3, "Precisam de Atencao",
			    _R = 2 && _V >= 3, "Em Risco",
			    _R = 2, "Hibernando",
			    "Perdidos")
		displayFolder: 06 RFV
		lineageTag: 0ee99d87-c7d6-5a0f-61d6-be81a53c8266

	measure 'Ranking Cliente' = RANKX(ALLSELECTED(dCliente[RazaoSocial]), [Receita USD], , DESC, DENSE)
		formatString: #,0
		displayFolder: 07 Pareto e ABC
		lineageTag: ed0dd1d0-5f97-c22a-4de0-b022131981eb

	measure 'Ranking Produto' = RANKX(ALLSELECTED(dProduto[Produto]), [Receita USD], , DESC, DENSE)
		formatString: #,0
		displayFolder: 07 Pareto e ABC
		lineageTag: 911a57f4-f959-2825-7c89-35db60461ca8

	measure 'Ranking Pais' = RANKX(ALLSELECTED(dPais[Pais]), [Receita USD], , DESC, DENSE)
		formatString: #,0
		displayFolder: 07 Pareto e ABC
		lineageTag: 3245c25b-70aa-2129-01f1-4c9e4c6572d6

	measure 'Receita Acumulada Cliente' =
			VAR _R = [Ranking Cliente]
			RETURN SUMX(FILTER(ALLSELECTED(dCliente[RazaoSocial]), [Ranking Cliente] <= _R), [Receita USD])
		formatString: "US$ "#,0.00
		displayFolder: 07 Pareto e ABC
		lineageTag: abcc3fb9-6e80-fb2a-59e4-70c328480302

	measure 'Receita Acumulada Cliente %' = DIVIDE([Receita Acumulada Cliente], CALCULATE([Receita USD], ALLSELECTED(dCliente[RazaoSocial])))
		formatString: #,0.0 %
		displayFolder: 07 Pareto e ABC
		lineageTag: fd1cd8d4-fc96-962b-5822-7764485b8bff

	measure 'Classe ABC Cliente' =
			VAR _P = [Receita Acumulada Cliente %]
			RETURN SWITCH(TRUE(), ISBLANK(_P), BLANK(), _P <= 0.8, "A", _P <= 0.95, "B", "C")
		displayFolder: 07 Pareto e ABC
		lineageTag: 0fd9957b-4f24-6c6a-f2b3-f12dbe68d1f5

	measure 'Receita Acumulada Produto %' =
			VAR _R = [Ranking Produto]
			VAR _Ac = SUMX(FILTER(ALLSELECTED(dProduto[Produto]), [Ranking Produto] <= _R), [Receita USD])
			RETURN DIVIDE(_Ac, CALCULATE([Receita USD], ALLSELECTED(dProduto[Produto])))
		formatString: #,0.0 %
		displayFolder: 07 Pareto e ABC
		lineageTag: 4174268a-c752-80c3-a767-ca87ce0ab470

	measure 'Classe ABC Produto' =
			VAR _P = [Receita Acumulada Produto %]
			RETURN SWITCH(TRUE(), ISBLANK(_P), BLANK(), _P <= 0.8, "A", _P <= 0.95, "B", "C")
		displayFolder: 07 Pareto e ABC
		lineageTag: 819652df-20f9-5c9a-b0bc-8955bcec6655

	measure 'Participacao Top 1' =
			VAR _T = CALCULATE([Receita USD], ALLSELECTED(dCliente))
			RETURN DIVIDE(MAXX(TOPN(1, ALLSELECTED(dCliente[ClienteID]), [Receita USD], DESC), [Receita USD]), _T)
		formatString: #,0.0 %
		displayFolder: 07 Pareto e ABC
		lineageTag: 24ca5ba6-3563-e7d8-59f5-d0ffa2173d6b

	measure 'Participacao Top 5' =
			VAR _T = CALCULATE([Receita USD], ALLSELECTED(dCliente))
			RETURN DIVIDE(SUMX(TOPN(5, ALLSELECTED(dCliente[ClienteID]), [Receita USD], DESC), [Receita USD]), _T)
		formatString: #,0.0 %
		displayFolder: 07 Pareto e ABC
		lineageTag: f34a32d9-2f8f-7ab0-1590-266103eb0bce

	measure 'Participacao Top 10' =
			VAR _T = CALCULATE([Receita USD], ALLSELECTED(dCliente))
			RETURN DIVIDE(SUMX(TOPN(10, ALLSELECTED(dCliente[ClienteID]), [Receita USD], DESC), [Receita USD]), _T)
		formatString: #,0.0 %
		displayFolder: 07 Pareto e ABC
		lineageTag: 61b1e8b6-4c18-f19d-6fda-99491669f0bb

	measure 'Participacao Top 20' =
			VAR _T = CALCULATE([Receita USD], ALLSELECTED(dCliente))
			RETURN DIVIDE(SUMX(TOPN(20, ALLSELECTED(dCliente[ClienteID]), [Receita USD], DESC), [Receita USD]), _T)
		formatString: #,0.0 %
		displayFolder: 07 Pareto e ABC
		lineageTag: f0c4b2b0-12d1-d1d6-b2d8-e6c1e9fa27ae

	/// Participacao do maior cliente na carteira do vendedor selecionado.
	measure 'Concentracao Carteira Vendedor' =
			VAR _T = [Receita USD]
			RETURN DIVIDE(MAXX(TOPN(1, VALUES(dCliente[ClienteID]), [Receita USD], DESC), [Receita USD]), _T)
		formatString: #,0.0 %
		displayFolder: 07 Pareto e ABC
		lineageTag: eeb2bafc-fbe6-3552-42a1-9fa400378098

	measure 'Potencial Anual USD' = SUM(dCliente[PotencialAnualEstimadoUSD])
		formatString: "US$ "#,0.00
