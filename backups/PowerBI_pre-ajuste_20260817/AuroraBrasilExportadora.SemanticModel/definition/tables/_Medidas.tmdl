table _Medidas
	/// Tabela dedicada as medidas DAX. Nao contem dados analiticos.
	lineageTag: 686b13ed-c80f-8a85-53e1-2b73d625ff6f

	/// Faturamento bruto em USD antes de descontos comerciais.
	measure 'Receita Bruta USD' = SUM(fVendas[ReceitaBrutaUSD])
		formatString: "US$ "#,0.00
		displayFolder: 01 Receita
		lineageTag: 47651f61-4d2e-5e7d-b858-dc99a6c6cad4

	/// Total de descontos comerciais concedidos.
	measure 'Descontos USD' = SUM(fVendas[DescontoUSD])
		formatString: "US$ "#,0.00
		displayFolder: 01 Receita
		lineageTag: 6921155b-4f0f-0f0f-3ee9-96f07d44588e

	measure 'Desconto %' = DIVIDE([Descontos USD], [Receita Bruta USD])
		formatString: #,0.0 %
		displayFolder: 01 Receita
		lineageTag: 1645ac19-07f1-1b91-2ee4-7faceee2146b

	/// Receita liquida em USD. Medida base de todo o relatorio.
	measure 'Receita USD' = SUM(fVendas[ReceitaLiquidaUSD])
		formatString: "US$ "#,0.00
		displayFolder: 01 Receita
		lineageTag: 2aeb2c55-e7b0-8ba4-eae7-cf60ce889572

	/// Receita liquida convertida a BRL pela taxa da data de faturamento.
	measure 'Receita BRL' = SUM(fVendas[ReceitaLiquidaBRL])
