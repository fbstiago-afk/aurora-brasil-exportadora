		lineageTag: 52d8d30b-25e8-7c60-3e4b-413a19c42d83

	measure 'Receita Pedido' = SUM(fVendas[ReceitaLiquidaUSD])
		formatString: "US$ "#,0.00
		displayFolder: 01 Receita
		lineageTag: 81a6a1fc-30db-5ab8-1ff8-690a97703caf

	/// Receita reconhecida pela data do pedido (relacionamento inativo).
	measure 'Receita por Data de Pedido' = CALCULATE([Receita USD], USERELATIONSHIP(dCalendario[Data], fVendas[DataPedido]))
		formatString: "US$ "#,0.00
		displayFolder: 01 Receita
		lineageTag: cb26c16f-f30a-6fdb-c6ae-527e643f0fad

	measure 'Receita LY' = CALCULATE([Receita USD], SAMEPERIODLASTYEAR(dCalendario[Data]))
		formatString: "US$ "#,0.00
		displayFolder: 02 Crescimento
		lineageTag: 5ce7a15b-8e58-a7ba-53b0-834d62b30ff6

	measure 'Receita YoY' = [Receita USD] - [Receita LY]
		formatString: "US$ "#,0.00
