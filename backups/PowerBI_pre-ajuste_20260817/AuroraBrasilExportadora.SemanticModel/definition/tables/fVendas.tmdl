	partition fVendas = m
		mode: import
		source =
				let
                    Origem = Csv.Document(
                        File.Contents(pBasePath & "fVendas.csv"),
                        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                    ),
                    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
                    TiposAplicados = Table.TransformColumnTypes(
                        CabecalhoPromovido,
                        {{"VendaID", Int64.Type},{"PedidoID", type text},{"DataPedido", type date},{"DataFaturamento", type date},{"ClienteID", Int64.Type},{"ProdutoID", Int64.Type},{"VendedorID", Int64.Type},{"PaisID", Int64.Type},{"Quantidade", Int64.Type},{"PesoTotalKg", type number},{"PrecoUnitarioUSD", type number},{"ReceitaBrutaUSD", type number},{"DescontoUSD", type number},{"ReceitaLiquidaUSD", type number},{"TaxaCambio", type number},{"ReceitaLiquidaBRL", type number},{"CustoProdutoBRL", type number},{"CustoProdutoUSD", type number},{"FreteUSD", type number},{"SeguroUSD", type number},{"DespesasExportacaoUSD", type number},{"CustoTotalUSD", type number},{"MargemBrutaUSD", type number},{"MargemBrutaPercentual", type number},{"MoedaNegociacao", type text},{"Incoterm", type text},{"CanalVenda", type text},{"NumeroInvoice", type text},{"StatusPedido", type text}},
                        "pt-BR"
                    ),
                    ErrosRemovidos = Table.RemoveRowsWithErrors(TiposAplicados)
                in
                    ErrosRemovidos

	annotation PBI_ResultType = Table
