	partition dVendedor = m
		mode: import
		source =
				let
                    Origem = Csv.Document(
                        File.Contents(pBasePath & "dVendedor.csv"),
                        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                    ),
                    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
                    TiposAplicados = Table.TransformColumnTypes(
                        CabecalhoPromovido,
                        {{"VendedorID", Int64.Type},{"CodigoVendedor", type text},{"NomeVendedor", type text},{"Cargo", type text},{"Gerente", type text},{"RegiaoResponsavel", type text},{"ContinenteResponsavel", type text},{"DataAdmissao", type date},{"MetaAnualUSD", type number},{"Status", type text}},
                        "pt-BR"
                    ),
                    ErrosRemovidos = Table.RemoveRowsWithErrors(TiposAplicados)
                in
                    ErrosRemovidos

	annotation PBI_ResultType = Table
