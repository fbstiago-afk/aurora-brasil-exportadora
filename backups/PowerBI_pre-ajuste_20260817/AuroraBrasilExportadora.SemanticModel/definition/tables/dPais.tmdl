	partition dPais = m
		mode: import
		source =
				let
                    Origem = Csv.Document(
                        File.Contents(pBasePath & "dPais.csv"),
                        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                    ),
                    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
                    TiposAplicados = Table.TransformColumnTypes(
                        CabecalhoPromovido,
                        {{"PaisID", Int64.Type},{"Pais", type text},{"CodigoISO", type text},{"Continente", type text},{"Regiao", type text},{"Moeda", type text},{"IdiomaPrincipal", type text},{"ClassificacaoMercado", type text},{"RiscoPais", type text},{"LeadTimeMedio", Int64.Type},{"TarifaMediaImportacao", type number}},
                        "pt-BR"
                    ),
                    ErrosRemovidos = Table.RemoveRowsWithErrors(TiposAplicados)
                in
                    ErrosRemovidos

	annotation PBI_ResultType = Table
