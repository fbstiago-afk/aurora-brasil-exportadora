	partition dProduto = m
		mode: import
		source =
				let
                    Origem = Csv.Document(
                        File.Contents(pBasePath & "dProduto.csv"),
                        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                    ),
                    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
                    TiposAplicados = Table.TransformColumnTypes(
                        CabecalhoPromovido,
                        {{"ProdutoID", Int64.Type},{"SKU", type text},{"Produto", type text},{"Categoria", type text},{"Subcategoria", type text},{"Linha", type text},{"Marca", type text},{"TipoEmbalagem", type text},{"PesoLiquidoKg", type number},{"UnidadeMedida", type text},{"OrigemBrasil", type text},{"EstadoOrigem", type text},{"CustoBaseBRL", type number},{"PrecoListaUSD", type number},{"MargemAlvo", type number},{"VidaUtilDias", Int64.Type},{"Certificacao", type text},{"StatusProduto", type text}},
                        "pt-BR"
                    ),
                    ErrosRemovidos = Table.RemoveRowsWithErrors(TiposAplicados)
                in
                    ErrosRemovidos

	annotation PBI_ResultType = Table
