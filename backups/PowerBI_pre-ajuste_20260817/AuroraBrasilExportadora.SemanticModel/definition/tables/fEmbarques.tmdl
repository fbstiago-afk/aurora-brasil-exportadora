	partition fEmbarques = m
		mode: import
		source =
				let
                    Origem = Csv.Document(
                        File.Contents(pBasePath & "fEmbarques.csv"),
                        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
                    ),
                    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
                    TiposAplicados = Table.TransformColumnTypes(
                        CabecalhoPromovido,
                        {{"EmbarqueID", Int64.Type},{"PedidoID", type text},{"ClienteID", Int64.Type},{"PaisDestinoID", Int64.Type},{"PortoOrigemID", Int64.Type},{"PortoDestinoID", Int64.Type},{"TransportadoraID", Int64.Type},{"DataPrevistaEmbarque", type date},{"DataRealEmbarque", type date},{"DataPrevistaEntrega", type date},{"DataRealEntrega", type date},{"Modal", type text},{"Container", type text},{"TipoContainer", type text},{"PesoKg", type number},{"VolumeM3", type number},{"FreteUSD", type number},{"SeguroUSD", type number},{"LeadTimePrevisto", Int64.Type},{"LeadTimeReal", Int64.Type},{"DiasAtraso", Int64.Type},{"StatusEmbarque", type text},{"MotivoAtraso", type text}},
                        "pt-BR"
                    ),
                    ErrosRemovidos = Table.RemoveRowsWithErrors(TiposAplicados)
                in
                    ErrosRemovidos

	annotation PBI_ResultType = Table
