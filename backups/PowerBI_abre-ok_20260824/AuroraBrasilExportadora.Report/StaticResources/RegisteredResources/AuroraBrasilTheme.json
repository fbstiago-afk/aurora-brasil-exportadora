{
  "name": "AuroraBrasilTheme",
  "dataColors": [
    "#17495A",
    "#C8763C",
    "#8FA98F",
    "#2F6F9F",
    "#D9A441",
    "#E9E1D4",
    "#1F8A70",
    "#C0453B",
    "#6B7C93",
    "#A98BC0"
  ],
  "background": "#F5F3EF",
  "foreground": "#16262C",
  "tableAccent": "#C8763C",
  "good": "#1F8A70",
  "bad": "#C0453B",
  "neutral": "#D9A441",
  "maximum": "#0E2A33",
  "minimum": "#E9E1D4",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0E2A33"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#16262C"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#16262C"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5D6E75"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E0D9"
              }
            },
            "radius": 6
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#16262C"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#16262C"
              }
            },
            "titleSize": 12,
            "searchTextSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F3EF"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}