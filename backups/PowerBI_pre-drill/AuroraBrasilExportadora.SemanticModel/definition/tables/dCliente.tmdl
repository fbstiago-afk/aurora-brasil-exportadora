	partition dCliente = m
		mode: import
		source =
				let
				    Origem = Csv.Document(
				        File.Contents(pBasePath & "dCliente.csv"),
				        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
				    TiposAplicados = Table.TransformColumnTypes(
				        CabecalhoPromovido,
				        {{"ClienteID", Int64.Type},{"CodigoCliente", type text},{"RazaoSocial", type text},{"NomeFantasia", type text},{"TipoCliente", type text},{"Segmento", type text},{"Subsegmento", type text},{"Porte", type text},{"Pais", type text},{"CodigoPais", type text},{"Continente", type text},{"RegiaoComercial", type text},{"Cidade", type text},{"EstadoProvincia", type text},{"MoedaPreferencial", type text},{"Idioma", type text},{"DataCadastro", type date},{"VendedorResponsavelID", Int64.Type},{"CanalVenda", type text},{"ClassificacaoCliente", type text},{"LimiteCreditoUSD", type number},{"PrazoPagamentoPadrao", Int64.Type},{"StatusCliente", type text},{"PotencialAnualEstimadoUSD", type number}},
				        "pt-BR"
				    ),
				    ErrosTratados = Table.ReplaceErrorValues(
				        TiposAplicados,
				        List.Transform(Table.ColumnNames(TiposAplicados), each {_, null})
				    )
				in
				    ErrosTratados

	annotation PBI_ResultType = Table

