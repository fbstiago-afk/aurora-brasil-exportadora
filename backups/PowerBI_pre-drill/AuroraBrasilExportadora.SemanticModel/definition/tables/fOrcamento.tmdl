/// Fato de orcamento anual aprovado na granularidade mes x regiao x categoria.
table fOrcamento
	lineageTag: 45b2f4e9-9030-1ed8-31b7-dcf071b8a5ef

	column Data
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 05903bc4-fe38-bb8c-3aa2-5f4b3159acb6
		summarizeBy: none
		sourceColumn: Data

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column AnoMesNumero
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 81b64cb1-684a-814c-dbd0-53be4c85396a
		summarizeBy: none
		sourceColumn: AnoMesNumero

		annotation SummarizationSetBy = Automatic

	column AnoMes
		dataType: string
		lineageTag: 9e28f45b-5490-7d80-8634-66adae9fc007
		summarizeBy: none
		sourceColumn: AnoMes
		sortByColumn: AnoMesNumero

		annotation SummarizationSetBy = Automatic

	column Ano
		dataType: int64
		formatString: #,0
		lineageTag: e5ecaff8-e6e3-a466-88a4-0b9126579346
		summarizeBy: sum
		sourceColumn: Ano

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: int64
		formatString: #,0
		lineageTag: c340d5c0-826a-52d9-592a-db13a3713c5f
		summarizeBy: sum
		sourceColumn: Mes

		annotation SummarizationSetBy = Automatic

	column Regiao
		dataType: string
		lineageTag: 7a45b415-c3a4-5d93-5ab0-e9562adbb00d
		summarizeBy: none
		sourceColumn: Regiao

		annotation SummarizationSetBy = Automatic

	column Categoria
		dataType: string
		lineageTag: adfaed42-b39c-7574-f687-e1a534b95827
		summarizeBy: none
		sourceColumn: Categoria

		annotation SummarizationSetBy = Automatic

	column ReceitaOrcadaUSD
		dataType: double
		formatString: #,0.00
		lineageTag: 31edc2f5-91b0-20b1-7592-e13c45f2b342
		summarizeBy: sum
		sourceColumn: ReceitaOrcadaUSD

		annotation SummarizationSetBy = Automatic

	column CustoOrcadoUSD
		dataType: double
		formatString: #,0.00
		lineageTag: d1fd269f-4af8-6c8c-142e-1d48154dd348
		summarizeBy: sum
		sourceColumn: CustoOrcadoUSD

		annotation SummarizationSetBy = Automatic

	column MargemOrcadaUSD
		dataType: double
		formatString: #,0.00
		lineageTag: 7501a661-54a4-984f-f524-0d4c46d04240
		summarizeBy: sum
		sourceColumn: MargemOrcadaUSD

		annotation SummarizationSetBy = Automatic

	column VolumeOrcadoKg
		dataType: double
		formatString: #,0.00
		lineageTag: c5412571-e323-5a37-9372-b8df5464fd57
		summarizeBy: sum
		sourceColumn: VolumeOrcadoKg

		annotation SummarizationSetBy = Automatic

	partition fOrcamento = m
		mode: import
		source =
				let
				    Origem = Csv.Document(
				        File.Contents(pBasePath & "fOrcamento.csv"),
				        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
				    TiposAplicados = Table.TransformColumnTypes(
				        CabecalhoPromovido,
				        {{"Data", type date},{"AnoMesNumero", Int64.Type},{"AnoMes", type text},{"Ano", Int64.Type},{"Mes", Int64.Type},{"Regiao", type text},{"Categoria", type text},{"ReceitaOrcadaUSD", type number},{"CustoOrcadoUSD", type number},{"MargemOrcadaUSD", type number},{"VolumeOrcadoKg", type number}},
				        "pt-BR"
				    ),
				    ErrosTratados = Table.ReplaceErrorValues(
				        TiposAplicados,
				        List.Transform(Table.ColumnNames(TiposAplicados), each {_, null})
				    )
				in
				    ErrosTratados

	annotation PBI_ResultType = Table

