		displayFolder: 10 Forecast e Orcamento
		lineageTag: 014c8319-c8a8-4b95-3148-f8e3eb81f0ce

	/// Peso historico do mes no total do periodo — base do orcamento adaptativo.
	measure 'Sazonalidade Historica %' =
			VAR _Mes = SELECTEDVALUE(dCalendario[NumeroMes])
			VAR _RecMes = CALCULATE([Receita USD], ALL(dCalendario), dCalendario[NumeroMes] = _Mes)
			VAR _RecTot = CALCULATE([Receita USD], ALL(dCalendario))
			RETURN DIVIDE(_RecMes, _RecTot)
		formatString: #,0.0 %
		displayFolder: 10 Forecast e Orcamento
		lineageTag: a962f506-3734-22b8-62a0-0c5b1fdaf95f

	/// Projecao linear de fechamento do ano com base no realizado acumulado.
	measure 'Projecao Fechamento Ano' =
			VAR _Ano = MAX(dCalendario[Ano])
			VAR _Realizado = CALCULATE([Receita USD], ALL(dCalendario), dCalendario[Ano] = _Ano,
			        dCalendario[Data] <= MAX(fVendas[DataFaturamento]))
			VAR _PesoRealizado = CALCULATE([Sazonalidade Historica %], ALL(dCalendario))
			VAR _MesesDecorridos = CALCULATE(MAX(dCalendario[NumeroMes]), ALL(dCalendario),
			        dCalendario[Data] <= MAX(fVendas[DataFaturamento]), dCalendario[Ano] = _Ano)
			RETURN DIVIDE(_Realizado, DIVIDE(_MesesDecorridos, 12))
		formatString: "US$ "#,0.00
		displayFolder: 10 Forecast e Orcamento
		lineageTag: 966c1625-d81e-efc2-698b-15db52d4de5e

	measure Embarques = DISTINCTCOUNT(fEmbarques[EmbarqueID])
		formatString: #,0
		displayFolder: 11 Logistica
		lineageTag: 4b2a082e-f2ae-e926-a06f-a5440e61a896

	measure 'Entregas Realizadas' = CALCULATE([Embarques], NOT(ISBLANK(fEmbarques[DiasAtraso])))
		formatString: #,0
		displayFolder: 11 Logistica
		lineageTag: 95d3bf6a-96fa-2914-dcc4-975585742422

	measure 'Embarques Atrasados' = CALCULATE([Embarques], fEmbarques[DiasAtraso] > 0)
		formatString: #,0
		displayFolder: 11 Logistica
		lineageTag: da04d448-f493-3ecb-3ace-d748442bc21b

	measure '% Embarques Atrasados' = DIVIDE([Embarques Atrasados], [Entregas Realizadas])
		formatString: #,0.0 %
		displayFolder: 11 Logistica
		lineageTag: 26d5f992-611a-d6b8-d0bc-1545d50b67c7

	measure 'On Time %' = DIVIDE([Entregas Realizadas] - [Embarques Atrasados], [Entregas Realizadas])
		formatString: #,0.0 %
		displayFolder: 11 Logistica
		lineageTag: fbacbe1f-3c91-b4ae-96bd-ccbdb8b06d52

	measure 'In Full %' = DIVIDE(CALCULATE([Embarques], fEmbarques[StatusEmbarque] <> "Aguardando embarque"), [Embarques])
		formatString: #,0.0 %
		displayFolder: 11 Logistica
		lineageTag: a233ce71-914d-8a90-0c5b-d59c9ee46594

	/// On Time In Full: proporcao de entregas no prazo e completas.
	measure 'OTIF %' = [On Time %] * [In Full %]
		formatString: #,0.0 %
		displayFolder: 11 Logistica
		lineageTag: 899fa9ae-6224-a05b-45e0-ee8d9c778fb6

	measure 'Lead Time Previsto' = AVERAGE(fEmbarques[LeadTimePrevisto])
		formatString: #,0.0
