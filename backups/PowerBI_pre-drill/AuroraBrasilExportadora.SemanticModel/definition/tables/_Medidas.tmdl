	measure 'Receita Forecast USD' =
			VAR _UltRev = CALCULATE(MAX(fForecast[DataForecast]), ALLSELECTED(fForecast))
			RETURN CALCULATE(SUM(fForecast[ReceitaForecastUSD]), fForecast[DataForecast] = _UltRev)
		formatString: "US$ "#,0.00
