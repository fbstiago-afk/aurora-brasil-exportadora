			        & "<div class='t'><div class='lb'>Receita da Equipe</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Receita USD] ) >= 1E9, "US$ " & FORMAT ( [Receita USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Receita USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & " style='color:" & _c0 & "'" & ">" & IF ( _d0 >= 0, "▲ ", "▼ " ) & FORMAT ( _d0, "0.0%", "pt-BR" ) & " " & "<em>vs ano anterior</em>" & "</div>"
