	measure 'Contas a Receber' = SUM(fRecebimentos[ValorUSD])
		formatString: "US$ "#,0.00
		displayFolder: 12 Financeiro
		lineageTag: e6641b9f-44a1-3bfd-52c4-42256ab0a2f6

	measure 'Recebido USD' = SUM(fRecebimentos[ValorRecebidoUSD])
		formatString: "US$ "#,0.00
		displayFolder: 12 Financeiro
		lineageTag: 80da33de-a7f5-476d-3d44-f2c909825f2d

	measure 'Saldo em Aberto' = SUM(fRecebimentos[SaldoUSD])
		formatString: "US$ "#,0.00
		displayFolder: 12 Financeiro
		lineageTag: 93e93c8f-6c31-b57e-bd3d-9b71031f4fee

	measure 'Saldo Vencido' = CALCULATE([Saldo em Aberto], fRecebimentos[Status] IN {"Vencido", "Parcial"})
		formatString: "US$ "#,0.00
		displayFolder: 12 Financeiro
		lineageTag: b0373803-bd8e-d645-32cf-3b0987e2c1f3

	measure 'Inadimplencia %' = DIVIDE([Saldo Vencido], [Contas a Receber])
		formatString: #,0.0 %
		displayFolder: 12 Financeiro
		lineageTag: 38f109c5-bd9f-9c0a-af92-46a21a54224a

	measure 'Dias Medios de Atraso' = CALCULATE(AVERAGE(fRecebimentos[DiasAtraso]), fRecebimentos[DiasAtraso] > 0)
		formatString: #,0.0
		displayFolder: 12 Financeiro
		lineageTag: e24aa959-d5fc-e659-4530-b5896537c8a4

	/// PMR em dias entre faturamento e pagamento efetivo.
	measure 'Prazo Medio Recebimento' =
			AVERAGEX(FILTER(fRecebimentos, NOT ISBLANK(fRecebimentos[DataPagamento])),
			    DATEDIFF(fRecebimentos[DataFaturamento], fRecebimentos[DataPagamento], DAY))
		formatString: #,0.0
		displayFolder: 12 Financeiro
		lineageTag: 9654007a-c129-68f4-a982-0c0b663bae23

	measure 'Faixa Aging' =
			VAR _Hoje = MAX(dCalendario[Data])
			VAR _D = AVERAGEX(fRecebimentos, DATEDIFF(fRecebimentos[DataVencimento], _Hoje, DAY))
			RETURN SWITCH(TRUE(), _D < 0, "A vencer", _D <= 30, "1-30 dias", _D <= 60, "31-60 dias",
			    _D <= 90, "61-90 dias", _D <= 180, "91-180 dias", "+180 dias")
		displayFolder: 12 Financeiro
		lineageTag: 1ea6b9fc-d5be-afaa-00b6-bad5fe462845

	measure 'Saldo Vencido +90' =
			VAR _Hoje = MAX(dCalendario[Data])
			RETURN CALCULATE([Saldo em Aberto],
			    FILTER(fRecebimentos, DATEDIFF(fRecebimentos[DataVencimento], _Hoje, DAY) > 90))
		formatString: "US$ "#,0.00
		displayFolder: 12 Financeiro
		lineageTag: fc02bdd7-8482-db3d-6149-a6fd1498fc02

	measure 'Taxa Media USD BRL' = CALCULATE(AVERAGE(fCambio[TaxaBRL]), fCambio[Moeda] = "USD")
		formatString: #,0.0000
		displayFolder: 13 Cambio
		lineageTag: 3b2fe259-c7c5-1b63-deb4-18fdb351d085

	measure 'Taxa Media Ponderada' = DIVIDE([Receita BRL], [Receita USD])
		formatString: #,0.0000
		displayFolder: 13 Cambio
		lineageTag: ebb215f2-3320-363e-71c0-4478d07cba87

	measure 'Taxa Media LY' = CALCULATE([Taxa Media Ponderada], SAMEPERIODLASTYEAR(dCalendario[Data]))
		formatString: #,0.0000
		displayFolder: 13 Cambio
		lineageTag: 256372ff-950a-d2cd-c691-199b4ee5d756

	/// Parcela da variacao da receita em BRL explicada apenas pela variacao cambial.
	measure 'Efeito Cambio BRL' = [Receita USD] * ([Taxa Media Ponderada] - [Taxa Media LY])
		formatString: "R$ "#,0.00
		displayFolder: 13 Cambio
		lineageTag: c1266da2-adbf-54ca-3d8c-57122d515560

	measure 'Crescimento Operacional BRL' =
			VAR _LY_BRL = CALCULATE([Receita BRL], SAMEPERIODLASTYEAR(dCalendario[Data]))
			RETURN [Receita BRL] - _LY_BRL - [Efeito Cambio BRL]
		formatString: "R$ "#,0.00
		displayFolder: 13 Cambio
		lineageTag: 5ccffc0b-2089-122d-9370-32690c82c30e

	measure 'Variacao Cambial %' = DIVIDE([Taxa Media Ponderada] - [Taxa Media LY], [Taxa Media LY])
		formatString: #,0.0 %
		displayFolder: 13 Cambio
		lineageTag: a1f079d6-1153-d1a6-563d-9eb11d771e40

	/// Quanto o elemento explica da variacao total de receita do periodo.
	measure 'Contribuicao para Crescimento' = DIVIDE([Receita YoY], CALCULATE([Receita YoY], ALLSELECTED()))
		formatString: #,0.0 %
		displayFolder: 14 Inteligencia Comercial
		lineageTag: 8166ece1-847a-3984-78e3-65e0f33bd63b

	measure 'Maior Crescimento Mercado' =
			VAR _T = TOPN(1, ALLSELECTED(dPais[Pais]), [Receita YoY], DESC)
			RETURN CONCATENATEX(_T, dPais[Pais], ", ")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: eb1860b2-dc20-ee4c-a4ed-e2e6453591e2

	measure 'Maior Queda Mercado' =
			VAR _T = TOPN(1, ALLSELECTED(dPais[Pais]), [Receita YoY], ASC)
			RETURN CONCATENATEX(_T, dPais[Pais], ", ")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: bd3db621-64d5-32b4-9c7d-29d37d37c92f

	/// Texto dinamico com sustentacao matematica para a area de insights.
	measure 'Cliente Maior Queda' =
			VAR _T = TOPN(1, ALLSELECTED(dCliente[RazaoSocial]), [Receita YoY], ASC)
			RETURN CONCATENATEX(_T, dCliente[RazaoSocial], ", ")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: 954d9073-1f9f-9613-c827-95a1d90206b5

	measure 'Texto Insight Crescimento' =
			VAR _Total = CALCULATE([Receita YoY], ALLSELECTED(dPais))
			VAR _TopPais = TOPN(1, ALLSELECTED(dPais[Pais]), [Receita YoY], DESC)
			VAR _Nome = CONCATENATEX(_TopPais, dPais[Pais], ", ")
			VAR _Val = MAXX(_TopPais, [Receita YoY])
			VAR _Part = DIVIDE(_Val, _Total)
			RETURN IF(ISBLANK(_Total) || _Total = 0, "Sem base comparativa no periodo selecionado.",
			    _Nome & " respondeu por " & FORMAT(_Part, "0.0%") & " da variacao de receita do periodo ("
			    & FORMAT(_Val, "$#,0,,.0M") & ").")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: 0b5dafda-f6c0-8b13-c643-64b614055858

	measure 'Texto Insight Margem' =
			VAR _pp = [Margem YoY p.p.]
			RETURN IF(ISBLANK(_pp), "Sem comparativo YoY.",
			    "Margem bruta " & IF(_pp >= 0, "avancou ", "recuou ") & FORMAT(ABS(_pp), "0.0")
			    & " p.p. YoY, hoje em " & FORMAT([Margem Bruta %], "0.0%") & ".")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: 9beb50e3-181c-674d-a3b9-63c0552a1aea

	measure 'Alerta Rota Critica' =
			VAR _T = TOPN(1, ALLSELECTED(dPais[Pais]), [% Embarques Atrasados], DESC)
			VAR _Nome = CONCATENATEX(_T, dPais[Pais], ", ")
			VAR _V = MAXX(_T, [% Embarques Atrasados])
			RETURN IF(ISBLANK(_V), BLANK(), _Nome & ": " & FORMAT(_V, "0.0%") & " de entregas atrasadas")
		displayFolder: 14 Inteligencia Comercial
		lineageTag: 655fbb56-28a1-253e-4580-e419fdf47133

	measure 'Cor Semaforo Meta' =
			VAR _A = [Atingimento %]
			RETURN SWITCH(TRUE(), ISBLANK(_A), "#8C96A5", _A >= 1, "#1F8A70", _A >= 0.9, "#D9A441", "#C0453B")
		displayFolder: 15 Formatacao
		lineageTag: d42b2a0f-5de6-0f54-7a65-d8dde50e5c6d

	measure 'Cor Variacao' = IF([Receita YoY] >= 0, "#1F8A70", "#C0453B")
		displayFolder: 15 Formatacao
		lineageTag: 2005db7e-b251-d77b-3515-6a72fdd81a28

	measure 'Icone Tendencia' = IF([Receita YoY] >= 0, "▲", "▼")
		displayFolder: 15 Formatacao
		lineageTag: 9df5abbc-dd69-8bed-cfd1-214682f0ee08

	measure 'KPI Receita Contexto' =
			IF(ISBLANK([Receita LY]), "sem comparativo",
			    [Icone Tendencia] & " " & FORMAT([Receita YoY %], "0.0%") & " YoY  ("
			    & FORMAT([Receita YoY], "$#,0,,.1M") & ")")
		displayFolder: 15 Formatacao
		lineageTag: f6cec6ce-9ed4-71ba-bf32-1ed272572fd0

	measure 'Titulo Periodo' =
			VAR _Ini = MIN(dCalendario[Data]) VAR _Fim = MAX(dCalendario[Data])
			RETURN IF(YEAR(_Ini) = YEAR(_Fim) && MONTH(_Ini) = MONTH(_Fim),
			    FORMAT(_Ini, "mmm/yyyy"),
			    FORMAT(_Ini, "mmm/yy") & " - " & FORMAT(_Fim, "mmm/yy"))
		displayFolder: 16 Titulos Dinamicos
		lineageTag: 52e85429-ef5e-98a3-76ed-53287351c3c0

	measure 'Titulo Filtros' =
			VAR _Cont = IF(ISFILTERED(dPais[Continente]),
			        CONCATENATEX(VALUES(dPais[Continente]), dPais[Continente], ", "), "Global")
			RETURN _Cont & " — " & [Titulo Periodo]
		displayFolder: 16 Titulos Dinamicos
		lineageTag: 6e0a86f0-4093-7e09-913b-176cf26306d6

	measure 'Titulo Receita por Pais' = "Receita por Pais — " & [Titulo Filtros]
		displayFolder: 16 Titulos Dinamicos
		lineageTag: abd8b332-bebc-f72e-dcf8-2f36dce9f624

	measure 'Titulo Performance Comercial' = "Performance Comercial — " & [Titulo Filtros]
		displayFolder: 16 Titulos Dinamicos
		lineageTag: c649fb8a-e844-b574-c85e-e1a99c018b4f

	measure 'Titulo Rentabilidade' = "Ponte de Rentabilidade — " & [Titulo Periodo]
		displayFolder: 16 Titulos Dinamicos
		lineageTag: 2462fbfa-ac4c-0629-26e5-5db35b607c00

	/// Painel de KPIs da pagina 01 Executive Overview.
	measure 'HTML Painel Executivo' =
			VAR _fim = MAX ( dCalendario[Data] )
			VAR _serie =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( dCalendario[AnoMesNumero] ),
			            DATESINPERIOD ( dCalendario[Data], _fim, -12, MONTH )
			        ),
			        "@s0", CALCULATE ( [Receita USD] ),
			        "@s1", CALCULATE ( [Margem Bruta %] ),
			        "@s3", CALCULATE ( [Toneladas] )
			    )
			VAR _mn0 = MINX ( _serie, [@s0] )
			VAR _mx0 = MAXX ( _serie, [@s0] )
			VAR _pt0 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s0] - _mn0, _mx0 - _mn0, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _mn1 = MINX ( _serie, [@s1] )
			VAR _mx1 = MAXX ( _serie, [@s1] )
			VAR _pt1 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s1] - _mn1, _mx1 - _mn1, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _mn3 = MINX ( _serie, [@s3] )
			VAR _mx3 = MAXX ( _serie, [@s3] )
			VAR _pt3 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s3] - _mn3, _mx3 - _mn3, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _d0 = [Receita YoY %]
			VAR _c0 = IF ( _d0 >= 0, "#1F8A70", "#C0453B" )
			VAR _d1 = [Margem YoY p.p.] * 100
			VAR _c1 = IF ( _d1 >= 0, "#1F8A70", "#C0453B" )
			VAR _c2 = IF ( [Atingimento %] >= 1, "#1F8A70", IF ( [Atingimento %] >= 0.9, "#D9A441", "#C0453B" ) )
			VAR _d3 = [Volume YoY %]
			VAR _c3 = IF ( _d3 >= 0, "#1F8A70", "#C0453B" )
			VAR _c7 = IF ( [OTIF %] >= 0.9, "#1F8A70", IF ( [OTIF %] >= 0.8, "#D9A441", "#C0453B" ) )
			
			VAR _css = "<style>
			*{box-sizing:border-box;margin:0;padding:0}
			html,body{height:100%;background:transparent;overflow:hidden}
			.ab{height:100%;display:grid;grid-auto-rows:1fr;gap:clamp(5px,.62vw,11px);font-family:'Segoe UI',system-ui,sans-serif}
			.t{background:rgba(255,255,255,.65);border:1px solid rgba(227,224,217,.65);border-radius:clamp(5px,.6vw,9px);padding:clamp(6px,.7vw,11px) clamp(8px,.85vw,14px);display:flex;flex-direction:column;gap:.15em;overflow:hidden;position:relative}
			.t:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#C8763C;opacity:.9}
			.t.b:before{background:#17495A}
			.t.g:before{background:#8FA98F}
			.lb{font-size:clamp(7.5px,.66vw,10px);letter-spacing:.06em;text-transform:uppercase;color:#5D6E75;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			.vl{font-size:clamp(14px,1.6vw,26px);font-weight:700;color:#0E2A33;line-height:1.05;letter-spacing:-.015em;white-space:nowrap}
			.dt{font-size:clamp(7.5px,.66vw,10px);font-weight:600;display:flex;align-items:baseline;gap:.3em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#5D6E75}
			.dt em{font-style:normal;color:#8C96A5;font-weight:500}
			.spk{display:flex;align-items:flex-end;gap:clamp(1px,.12vw,2.5px);flex:1;min-height:clamp(11px,1.3vw,24px);margin-top:.2em}
			.spk i{flex:1 1 0;background:currentColor;border-radius:1.5px 1.5px 0 0;opacity:.9;min-width:1px}
			.spk i:last-child{opacity:1}
			.bar{position:relative;height:clamp(4px,.4vw,7px);background:rgba(233,225,212,.7);border-radius:99px;margin-top:auto;overflow:hidden}
			.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:99px}
			.bar u{position:absolute;top:0;bottom:0;width:1.5px;background:#0E2A33;opacity:.5}
			</style>"
			
			VAR _html =
			    _css
			        & "<div class='ab' style=""grid-template-columns:repeat(4,1fr)"">"
			        & "<div class='t'><div class='lb'>Receita USD</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Receita USD] ) >= 1E9, "US$ " & FORMAT ( [Receita USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Receita USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & " style='color:" & _c0 & "'" & ">" & IF ( _d0 >= 0, "▲ ", "▼ " ) & FORMAT ( _d0, "0.0%", "pt-BR" ) & " " & "<em>vs ano anterior</em>" & "</div>"
			            & "<div class='spk' style='color:#C8763C'>" & _pt0 & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Margem Bruta</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Margem Bruta %], "0.0%", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & " style='color:" & _c1 & "'" & ">" & IF ( _d1 >= 0, "▲ ", "▼ " ) & FORMAT ( _d1, "0.0", "pt-BR" ) & " p.p. " & "<em>YoY</em>" & "</div>"
			            & "<div class='spk' style='color:#17495A'>" & _pt1 & "</div>"
			            & "</div>"
			        & "<div class='t g'><div class='lb'>Atingimento da Meta</div>"
			            & "<div class='vl'" & " style='color:" & _c2 & "'" & ">" & FORMAT ( [Atingimento %], "0.0%", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>meta " & IF ( ABS ( [Meta Receita USD] ) >= 1E9, "US$ " & FORMAT ( [Meta Receita USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Meta Receita USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</em>" & "</div>"
			            & "<div class='bar'><i style='width:"
			            & FORMAT ( MIN ( MAX ( [Atingimento %], 0 ), 1.5 ) / 1.5 * 100, "0.0", "en-US" )
			            & "%;background:" & _c2 & "'></i><u style='left:66.7%'></u></div>"
			            & "</div>"
			        & "<div class='t'><div class='lb'>Volume Exportado</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Toneladas] / 1000, "#,0.0", "pt-BR" ) & " Mil t" & "</div>"
			            & "<div class='dt'" & " style='color:" & _c3 & "'" & ">" & IF ( _d3 >= 0, "▲ ", "▼ " ) & FORMAT ( _d3, "0.0%", "pt-BR" ) & " " & "<em>vs ano anterior</em>" & "</div>"
			            & "<div class='spk' style='color:#C8763C'>" & _pt3 & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Receita em BRL</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Receita BRL] ) >= 1E9, "R$ " & FORMAT ( [Receita BRL] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "R$ " & FORMAT ( [Receita BRL] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>câmbio médio R$ " & FORMAT([Taxa Media Ponderada],"#,0.00","pt-BR") & "</em>" & "</div>"
			            & "</div>"
			        & "<div class='t g'><div class='lb'>Clientes Ativos</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Clientes Ativos], "#,0", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>" & FORMAT([Novos Clientes],"#,0","pt-BR") & " novos · " & FORMAT([Clientes Perdidos],"#,0","pt-BR") & " perdidos</em>" & "</div>"
			            & "</div>"
			        & "<div class='t'><div class='lb'>Pedidos Faturados</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Pedidos] / 1000, "#,0.0", "pt-BR" ) & " Mil" & "</div>"
			            & "<div class='dt'" & ">" & "<em>ticket " & "US$ " & FORMAT ( [Ticket Medio USD], "#,0", "pt-BR" ) & "</em>" & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>OTIF Logístico</div>"
			            & "<div class='vl'" & " style='color:" & _c7 & "'" & ">" & FORMAT ( [OTIF %], "0.0%", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>" & FORMAT([% Embarques Atrasados],"0.0%","pt-BR") & " com atraso</em>" & "</div>"
			            & "<div class='bar'><i style='width:"
			            & FORMAT ( MIN ( MAX ( [OTIF %], 0 ), 1 ) / 1 * 100, "0.0", "en-US" )
			            & "%;background:" & _c7 & "'></i><u style='left:90.0%'></u></div>"
			            & "</div>"
			        & "</div>"
			RETURN
			    _html
		displayFolder: 17 Paineis HTML
		lineageTag: 15113f04-faa3-3ced-c05f-5722fb70a5b3

	/// Painel de KPIs da pagina 02 Sales Performance.
	measure 'HTML Painel Vendas' =
			VAR _fim = MAX ( dCalendario[Data] )
			VAR _serie =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( dCalendario[AnoMesNumero] ),
			            DATESINPERIOD ( dCalendario[Data], _fim, -12, MONTH )
			        ),
			        "@s0", CALCULATE ( [Receita USD] ),
			        "@s3", CALCULATE ( [Ticket Medio USD] ),
			        "@s4", CALCULATE ( [Pedidos] )
			    )
			VAR _mn0 = MINX ( _serie, [@s0] )
			VAR _mx0 = MAXX ( _serie, [@s0] )
			VAR _pt0 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s0] - _mn0, _mx0 - _mn0, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _mn3 = MINX ( _serie, [@s3] )
			VAR _mx3 = MAXX ( _serie, [@s3] )
			VAR _pt3 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s3] - _mn3, _mx3 - _mn3, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _mn4 = MINX ( _serie, [@s4] )
			VAR _mx4 = MAXX ( _serie, [@s4] )
			VAR _pt4 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s4] - _mn4, _mx4 - _mn4, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _d0 = [Receita YoY %]
			VAR _c0 = IF ( _d0 >= 0, "#1F8A70", "#C0453B" )
			VAR _c2 = IF ( [Gap Meta USD] >= 0, "#1F8A70", "#C0453B" )
			
			VAR _css = "<style>
			*{box-sizing:border-box;margin:0;padding:0}
			html,body{height:100%;background:transparent;overflow:hidden}
			.ab{height:100%;display:grid;grid-auto-rows:1fr;gap:clamp(5px,.62vw,11px);font-family:'Segoe UI',system-ui,sans-serif}
			.t{background:rgba(255,255,255,.65);border:1px solid rgba(227,224,217,.65);border-radius:clamp(5px,.6vw,9px);padding:clamp(6px,.7vw,11px) clamp(8px,.85vw,14px);display:flex;flex-direction:column;gap:.15em;overflow:hidden;position:relative}
			.t:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#C8763C;opacity:.9}
			.t.b:before{background:#17495A}
			.t.g:before{background:#8FA98F}
			.lb{font-size:clamp(7.5px,.66vw,10px);letter-spacing:.06em;text-transform:uppercase;color:#5D6E75;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			.vl{font-size:clamp(14px,1.6vw,26px);font-weight:700;color:#0E2A33;line-height:1.05;letter-spacing:-.015em;white-space:nowrap}
			.dt{font-size:clamp(7.5px,.66vw,10px);font-weight:600;display:flex;align-items:baseline;gap:.3em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#5D6E75}
			.dt em{font-style:normal;color:#8C96A5;font-weight:500}
			.spk{display:flex;align-items:flex-end;gap:clamp(1px,.12vw,2.5px);flex:1;min-height:clamp(11px,1.3vw,24px);margin-top:.2em}
			.spk i{flex:1 1 0;background:currentColor;border-radius:1.5px 1.5px 0 0;opacity:.9;min-width:1px}
			.spk i:last-child{opacity:1}
			.bar{position:relative;height:clamp(4px,.4vw,7px);background:rgba(233,225,212,.7);border-radius:99px;margin-top:auto;overflow:hidden}
			.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:99px}
			.bar u{position:absolute;top:0;bottom:0;width:1.5px;background:#0E2A33;opacity:.5}
			</style>"
			
			VAR _html =
			    _css
			        & "<div class='ab' style=""grid-template-columns:repeat(5,1fr)"">"
			        & "<div class='t'><div class='lb'>Receita</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Receita USD] ) >= 1E9, "US$ " & FORMAT ( [Receita USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Receita USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & " style='color:" & _c0 & "'" & ">" & IF ( _d0 >= 0, "▲ ", "▼ " ) & FORMAT ( _d0, "0.0%", "pt-BR" ) & " " & "<em>vs ano anterior</em>" & "</div>"
			            & "<div class='spk' style='color:#C8763C'>" & _pt0 & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Meta</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Meta Receita USD] ) >= 1E9, "US$ " & FORMAT ( [Meta Receita USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Meta Receita USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>" & [Status Meta] & "</em>" & "</div>"
			            & "</div>"
			        & "<div class='t g'><div class='lb'>Gap versus Meta</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Gap Meta USD] ) >= 1E9, "US$ " & FORMAT ( [Gap Meta USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Gap Meta USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & " style='color:" & _c2 & "'" & ">" & "<em>realizado − meta</em>" & "</div>"
			            & "</div>"
			        & "<div class='t'><div class='lb'>Ticket Médio</div>"
			            & "<div class='vl'" & ">" & "US$ " & FORMAT ( [Ticket Medio USD], "#,0", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>por pedido</em>" & "</div>"
			            & "<div class='spk' style='color:#C8763C'>" & _pt3 & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Pedidos</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Pedidos] / 1000, "#,0.0", "pt-BR" ) & " Mil" & "</div>"
			            & "<div class='dt'" & ">" & "<em>no período</em>" & "</div>"
			            & "<div class='spk' style='color:#17495A'>" & _pt4 & "</div>"
			            & "</div>"
			        & "</div>"
			RETURN
			    _html
		displayFolder: 17 Paineis HTML
		lineageTag: 9e58bc63-4cc0-9060-643a-e91942710dde

	/// Painel de KPIs da pagina 03 Customers.
	measure 'HTML Painel Clientes' =
			VAR _fim = MAX ( dCalendario[Data] )
			VAR _serie =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( dCalendario[AnoMesNumero] ),
			            DATESINPERIOD ( dCalendario[Data], _fim, -12, MONTH )
			        ),
			        "@s0", CALCULATE ( [Clientes Ativos] ),
			        "@s1", CALCULATE ( [Novos Clientes] )
			    )
			VAR _mn0 = MINX ( _serie, [@s0] )
			VAR _mx0 = MAXX ( _serie, [@s0] )
			VAR _pt0 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s0] - _mn0, _mx0 - _mn0, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _mn1 = MINX ( _serie, [@s1] )
			VAR _mx1 = MAXX ( _serie, [@s1] )
			VAR _pt1 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s1] - _mn1, _mx1 - _mn1, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _c4 = IF ( [Taxa de Churn %] <= 0.05, "#1F8A70", IF ( [Taxa de Churn %] <= 0.1, "#D9A441", "#C0453B" ) )
			
			VAR _css = "<style>
			*{box-sizing:border-box;margin:0;padding:0}
			html,body{height:100%;background:transparent;overflow:hidden}
			.ab{height:100%;display:grid;grid-auto-rows:1fr;gap:clamp(5px,.62vw,11px);font-family:'Segoe UI',system-ui,sans-serif}
			.t{background:rgba(255,255,255,.65);border:1px solid rgba(227,224,217,.65);border-radius:clamp(5px,.6vw,9px);padding:clamp(6px,.7vw,11px) clamp(8px,.85vw,14px);display:flex;flex-direction:column;gap:.15em;overflow:hidden;position:relative}
			.t:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#C8763C;opacity:.9}
			.t.b:before{background:#17495A}
			.t.g:before{background:#8FA98F}
			.lb{font-size:clamp(7.5px,.66vw,10px);letter-spacing:.06em;text-transform:uppercase;color:#5D6E75;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			.vl{font-size:clamp(14px,1.6vw,26px);font-weight:700;color:#0E2A33;line-height:1.05;letter-spacing:-.015em;white-space:nowrap}
			.dt{font-size:clamp(7.5px,.66vw,10px);font-weight:600;display:flex;align-items:baseline;gap:.3em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#5D6E75}
			.dt em{font-style:normal;color:#8C96A5;font-weight:500}
			.spk{display:flex;align-items:flex-end;gap:clamp(1px,.12vw,2.5px);flex:1;min-height:clamp(11px,1.3vw,24px);margin-top:.2em}
			.spk i{flex:1 1 0;background:currentColor;border-radius:1.5px 1.5px 0 0;opacity:.9;min-width:1px}
			.spk i:last-child{opacity:1}
			.bar{position:relative;height:clamp(4px,.4vw,7px);background:rgba(233,225,212,.7);border-radius:99px;margin-top:auto;overflow:hidden}
			.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:99px}
			.bar u{position:absolute;top:0;bottom:0;width:1.5px;background:#0E2A33;opacity:.5}
			</style>"
			
			VAR _html =
			    _css
			        & "<div class='ab' style=""grid-template-columns:repeat(6,1fr)"">"
			        & "<div class='t'><div class='lb'>Clientes Ativos</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Clientes Ativos], "#,0", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>com faturamento</em>" & "</div>"
			            & "<div class='spk' style='color:#C8763C'>" & _pt0 & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Novos</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Novos Clientes], "#,0", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>1ª compra no período</em>" & "</div>"
			            & "<div class='spk' style='color:#17495A'>" & _pt1 & "</div>"
			            & "</div>"
			        & "<div class='t g'><div class='lb'>Reativados</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Clientes Reativados], "#,0", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>após 180d parados</em>" & "</div>"
			            & "</div>"
			        & "<div class='t'><div class='lb'>Perdidos</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Clientes Perdidos], "#,0", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>sem compra há 365d</em>" & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Churn</div>"
			            & "<div class='vl'" & " style='color:" & _c4 & "'" & ">" & FORMAT ( [Taxa de Churn %], "0.0%", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>perdidos / base</em>" & "</div>"
			            & "</div>"
			        & "<div class='t g'><div class='lb'>Receita em Risco</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Receita em Risco] ) >= 1E9, "US$ " & FORMAT ( [Receita em Risco] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Receita em Risco] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>clientes 180d+ parados</em>" & "</div>"
			            & "</div>"
			        & "</div>"
			RETURN
			    _html
		displayFolder: 17 Paineis HTML
		lineageTag: 3f03c91d-e551-a792-31bf-0563af8ba560

	/// Painel de KPIs da pagina 04 Customer Potential.
	measure 'HTML Painel Potencial' =
			VAR _fim = MAX ( dCalendario[Data] )
			VAR _serie =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( dCalendario[AnoMesNumero] ),
			            DATESINPERIOD ( dCalendario[Data], _fim, -12, MONTH )
			        ),
			        "@s0", CALCULATE ( [Receita 12M] )
			    )
			VAR _mn0 = MINX ( _serie, [@s0] )
			VAR _mx0 = MAXX ( _serie, [@s0] )
			VAR _pt0 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s0] - _mn0, _mx0 - _mn0, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _c2 = IF ( [Share of Wallet] >= 0.4, "#1F8A70", IF ( [Share of Wallet] >= 0.25, "#D9A441", "#C0453B" ) )
			
			VAR _css = "<style>
			*{box-sizing:border-box;margin:0;padding:0}
			html,body{height:100%;background:transparent;overflow:hidden}
			.ab{height:100%;display:grid;grid-auto-rows:1fr;gap:clamp(5px,.62vw,11px);font-family:'Segoe UI',system-ui,sans-serif}
			.t{background:rgba(255,255,255,.65);border:1px solid rgba(227,224,217,.65);border-radius:clamp(5px,.6vw,9px);padding:clamp(6px,.7vw,11px) clamp(8px,.85vw,14px);display:flex;flex-direction:column;gap:.15em;overflow:hidden;position:relative}
			.t:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#C8763C;opacity:.9}
			.t.b:before{background:#17495A}
			.t.g:before{background:#8FA98F}
			.lb{font-size:clamp(7.5px,.66vw,10px);letter-spacing:.06em;text-transform:uppercase;color:#5D6E75;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			.vl{font-size:clamp(14px,1.6vw,26px);font-weight:700;color:#0E2A33;line-height:1.05;letter-spacing:-.015em;white-space:nowrap}
			.dt{font-size:clamp(7.5px,.66vw,10px);font-weight:600;display:flex;align-items:baseline;gap:.3em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#5D6E75}
			.dt em{font-style:normal;color:#8C96A5;font-weight:500}
			.spk{display:flex;align-items:flex-end;gap:clamp(1px,.12vw,2.5px);flex:1;min-height:clamp(11px,1.3vw,24px);margin-top:.2em}
			.spk i{flex:1 1 0;background:currentColor;border-radius:1.5px 1.5px 0 0;opacity:.9;min-width:1px}
			.spk i:last-child{opacity:1}
			.bar{position:relative;height:clamp(4px,.4vw,7px);background:rgba(233,225,212,.7);border-radius:99px;margin-top:auto;overflow:hidden}
			.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:99px}
			.bar u{position:absolute;top:0;bottom:0;width:1.5px;background:#0E2A33;opacity:.5}
			</style>"
			
			VAR _html =
			    _css
			        & "<div class='ab' style=""grid-template-columns:repeat(4,1fr)"">"
			        & "<div class='t'><div class='lb'>Receita 12 Meses</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Receita 12M] ) >= 1E9, "US$ " & FORMAT ( [Receita 12M] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Receita 12M] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>últimos 12 meses</em>" & "</div>"
			            & "<div class='spk' style='color:#C8763C'>" & _pt0 & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Potencial Estimado</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Potencial Anual USD] ) >= 1E9, "US$ " & FORMAT ( [Potencial Anual USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Potencial Anual USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>estimativa da base</em>" & "</div>"
			            & "</div>"
			        & "<div class='t g'><div class='lb'>Share of Wallet</div>"
			            & "<div class='vl'" & " style='color:" & _c2 & "'" & ">" & FORMAT ( [Share of Wallet], "0.0%", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>receita / potencial</em>" & "</div>"
			            & "<div class='bar'><i style='width:"
			            & FORMAT ( MIN ( MAX ( [Share of Wallet], 0 ), 1 ) / 1 * 100, "0.0", "en-US" )
			            & "%;background:" & _c2 & "'></i><u style='left:40.0%'></u></div>"
			            & "</div>"
			        & "<div class='t'><div class='lb'>Gap Não Capturado</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Potencial Nao Capturado] ) >= 1E9, "US$ " & FORMAT ( [Potencial Nao Capturado] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Potencial Nao Capturado] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>espaço para crescer</em>" & "</div>"
			            & "</div>"
			        & "</div>"
			RETURN
			    _html
		displayFolder: 17 Paineis HTML
		lineageTag: d6e4f81d-8684-aa92-b161-4c636345e060

	/// Painel de KPIs da pagina 05 Products.
	measure 'HTML Painel Produtos' =
			VAR _fim = MAX ( dCalendario[Data] )
			VAR _serie =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( dCalendario[AnoMesNumero] ),
			            DATESINPERIOD ( dCalendario[Data], _fim, -12, MONTH )
			        ),
			        "@s0", CALCULATE ( [Receita USD] ),
			        "@s1", CALCULATE ( [Margem Bruta %] ),
			        "@s2", CALCULATE ( [Toneladas] ),
			        "@s3", CALCULATE ( [Preco Medio por Kg] )
			    )
			VAR _mn0 = MINX ( _serie, [@s0] )
			VAR _mx0 = MAXX ( _serie, [@s0] )
			VAR _pt0 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
