			            & "<div class='dt'" & " style='color:" & _c1 & "'" & ">" & IF ( _d1 >= 0, "▲ ", "▼ " ) & FORMAT ( _d1, "0.0%", "pt-BR" ) & " " & "<em>vs ano anterior</em>" & "</div>"
