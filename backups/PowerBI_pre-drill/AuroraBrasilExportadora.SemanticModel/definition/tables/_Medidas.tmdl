		lineageTag: 6738b98e-840a-1020-2c70-d91e6d513e6d

	/// Prioriza clientes com grande gap absoluto e baixa penetracao.
	measure 'Score de Oportunidade' =
			VAR _SoW = [Share of Wallet]
			VAR _Gap = [Potencial Nao Capturado]
			RETURN IF(ISBLANK(_SoW), BLANK(), _Gap * (1 - _SoW))
		formatString: "US$ "#,0.00
		displayFolder: 08 Potencial
		lineageTag: a1e76971-7ebd-5330-49ac-a87fbf4e6237

	measure 'Categorias Compradas' = CALCULATE(DISTINCTCOUNT(dProduto[Categoria]), fVendas)
