			    )
			VAR _d0 = [Receita YoY %]
			VAR _c0 = IF ( _d0 >= 0, "#1F8A70", "#C0453B" )
			VAR _c1 = IF ( [Atingimento %] >= 1, "#1F8A70", IF ( [Atingimento %] >= 0.9, "#D9A441", "#C0453B" ) )
			VAR _d3 = [Margem YoY p.p.] * 100
			VAR _c3 = IF ( _d3 >= 0, "#1F8A70", "#C0453B" )
			
