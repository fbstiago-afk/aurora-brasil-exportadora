	/// Painel de KPIs da pagina 07 Profitability.
	measure 'HTML Painel Rentabilidade' =
			VAR _fim = MAX ( dCalendario[Data] )
			VAR _serie =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( dCalendario[AnoMesNumero] ),
			            DATESINPERIOD ( dCalendario[Data], _fim, -12, MONTH )
			        ),
			        "@s0", CALCULATE ( [Receita Bruta USD] ),
			        "@s3", CALCULATE ( [Margem Bruta USD] ),
			        "@s4", CALCULATE ( [Margem Bruta %] )
			    )
			VAR _mn0 = MINX ( _serie, [@s0] )
			VAR _mx0 = MAXX ( _serie, [@s0] )
			VAR _pt0 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s0] - _mn0, _mx0 - _mn0, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _mn3 = MINX ( _serie, [@s3] )
			VAR _mx3 = MAXX ( _serie, [@s3] )
			VAR _pt3 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s3] - _mn3, _mx3 - _mn3, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _mn4 = MINX ( _serie, [@s4] )
			VAR _mx4 = MAXX ( _serie, [@s4] )
			VAR _pt4 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s4] - _mn4, _mx4 - _mn4, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _d3 = [Margem YoY %]
			VAR _c3 = IF ( _d3 >= 0, "#1F8A70", "#C0453B" )
			VAR _d4 = [Margem YoY p.p.] * 100
			VAR _c4 = IF ( _d4 >= 0, "#1F8A70", "#C0453B" )
			
			VAR _css = "<style>
			*{box-sizing:border-box;margin:0;padding:0}
			html,body{height:100%;background:transparent;overflow:hidden}
			.ab{height:100%;display:grid;grid-auto-rows:1fr;gap:clamp(5px,.62vw,11px);font-family:'Segoe UI',system-ui,sans-serif}
			.t{background:rgba(255,255,255,.65);border:1px solid rgba(227,224,217,.65);border-radius:clamp(5px,.6vw,9px);padding:clamp(6px,.7vw,11px) clamp(8px,.85vw,14px);display:flex;flex-direction:column;gap:.15em;overflow:hidden;position:relative}
			.t:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#C8763C;opacity:.9}
			.t.b:before{background:#17495A}
			.t.g:before{background:#8FA98F}
			.lb{font-size:clamp(7.5px,.66vw,10px);letter-spacing:.06em;text-transform:uppercase;color:#5D6E75;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			.vl{font-size:clamp(14px,1.6vw,26px);font-weight:700;color:#0E2A33;line-height:1.05;letter-spacing:-.015em;white-space:nowrap}
			.dt{font-size:clamp(7.5px,.66vw,10px);font-weight:600;display:flex;align-items:baseline;gap:.3em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#5D6E75}
			.dt em{font-style:normal;color:#8C96A5;font-weight:500}
			.spk{display:flex;align-items:flex-end;gap:clamp(1px,.12vw,2.5px);flex:1;min-height:clamp(11px,1.3vw,24px);margin-top:.2em}
			.spk i{flex:1 1 0;background:currentColor;border-radius:1.5px 1.5px 0 0;opacity:.9;min-width:1px}
			.spk i:last-child{opacity:1}
			.bar{position:relative;height:clamp(4px,.4vw,7px);background:rgba(233,225,212,.7);border-radius:99px;margin-top:auto;overflow:hidden}
			.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:99px}
			.bar u{position:absolute;top:0;bottom:0;width:1.5px;background:#0E2A33;opacity:.5}
			</style>"
			
			VAR _html =
			    _css
			        & "<div class='ab' style=""grid-template-columns:repeat(5,1fr)"">"
			        & "<div class='t'><div class='lb'>Receita Bruta</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Receita Bruta USD] ) >= 1E9, "US$ " & FORMAT ( [Receita Bruta USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Receita Bruta USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>antes de descontos</em>" & "</div>"
			            & "<div class='spk' style='color:#C8763C'>" & _pt0 & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Descontos</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Descontos USD] ) >= 1E9, "US$ " & FORMAT ( [Descontos USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Descontos USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>" & FORMAT([Desconto %],"0.0%","pt-BR") & " da bruta</em>" & "</div>"
			            & "</div>"
			        & "<div class='t g'><div class='lb'>Custo Total</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Custo Total USD] ) >= 1E9, "US$ " & FORMAT ( [Custo Total USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Custo Total USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>produto + frete + seguro</em>" & "</div>"
			            & "</div>"
			        & "<div class='t'><div class='lb'>Margem Bruta</div>"
			            & "<div class='vl'" & ">" & IF ( ABS ( [Margem Bruta USD] ) >= 1E9, "US$ " & FORMAT ( [Margem Bruta USD] / 1E9, "#,0.0", "pt-BR" ) & " Bi", "US$ " & FORMAT ( [Margem Bruta USD] / 1E6, "#,0.0", "pt-BR" ) & " Mi" ) & "</div>"
			            & "<div class='dt'" & " style='color:" & _c3 & "'" & ">" & IF ( _d3 >= 0, "▲ ", "▼ " ) & FORMAT ( _d3, "0.0%", "pt-BR" ) & " " & "<em>vs ano anterior</em>" & "</div>"
			            & "<div class='spk' style='color:#C8763C'>" & _pt3 & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Margem %</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Margem Bruta %], "0.0%", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & " style='color:" & _c4 & "'" & ">" & IF ( _d4 >= 0, "▲ ", "▼ " ) & FORMAT ( _d4, "0.0", "pt-BR" ) & " p.p. " & "<em>YoY</em>" & "</div>"
			            & "<div class='spk' style='color:#17495A'>" & _pt4 & "</div>"
			            & "</div>"
			        & "</div>"
			RETURN
			    _html
		displayFolder: 17 Paineis HTML
		lineageTag: e198d8bc-fd85-c045-ece6-139a3b0b74cb

	/// Painel de KPIs da pagina 08 Logistics.
	measure 'HTML Painel Logistica' =
			VAR _fim = MAX ( dCalendario[Data] )
			VAR _serie =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( dCalendario[AnoMesNumero] ),
			            DATESINPERIOD ( dCalendario[Data], _fim, -12, MONTH )
			        ),
			        "@s1", CALCULATE ( [Lead Time Real] ),
			        "@s2", CALCULATE ( [% Embarques Atrasados] ),
			        "@s4", CALCULATE ( [Frete por Kg] )
			    )
			VAR _mn1 = MINX ( _serie, [@s1] )
			VAR _mx1 = MAXX ( _serie, [@s1] )
			VAR _pt1 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s1] - _mn1, _mx1 - _mn1, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _mn2 = MINX ( _serie, [@s2] )
			VAR _mx2 = MAXX ( _serie, [@s2] )
			VAR _pt2 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s2] - _mn2, _mx2 - _mn2, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _mn4 = MINX ( _serie, [@s4] )
			VAR _mx4 = MAXX ( _serie, [@s4] )
			VAR _pt4 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s4] - _mn4, _mx4 - _mn4, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _c0 = IF ( [OTIF %] >= 0.9, "#1F8A70", IF ( [OTIF %] >= 0.8, "#D9A441", "#C0453B" ) )
			VAR _c2 = IF ( [% Embarques Atrasados] <= 0.1, "#1F8A70", IF ( [% Embarques Atrasados] <= 0.2, "#D9A441", "#C0453B" ) )
			
			VAR _css = "<style>
			*{box-sizing:border-box;margin:0;padding:0}
			html,body{height:100%;background:transparent;overflow:hidden}
			.ab{height:100%;display:grid;grid-auto-rows:1fr;gap:clamp(5px,.62vw,11px);font-family:'Segoe UI',system-ui,sans-serif}
			.t{background:rgba(255,255,255,.65);border:1px solid rgba(227,224,217,.65);border-radius:clamp(5px,.6vw,9px);padding:clamp(6px,.7vw,11px) clamp(8px,.85vw,14px);display:flex;flex-direction:column;gap:.15em;overflow:hidden;position:relative}
			.t:before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:#C8763C;opacity:.9}
			.t.b:before{background:#17495A}
			.t.g:before{background:#8FA98F}
			.lb{font-size:clamp(7.5px,.66vw,10px);letter-spacing:.06em;text-transform:uppercase;color:#5D6E75;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
			.vl{font-size:clamp(14px,1.6vw,26px);font-weight:700;color:#0E2A33;line-height:1.05;letter-spacing:-.015em;white-space:nowrap}
			.dt{font-size:clamp(7.5px,.66vw,10px);font-weight:600;display:flex;align-items:baseline;gap:.3em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#5D6E75}
			.dt em{font-style:normal;color:#8C96A5;font-weight:500}
			.spk{display:flex;align-items:flex-end;gap:clamp(1px,.12vw,2.5px);flex:1;min-height:clamp(11px,1.3vw,24px);margin-top:.2em}
			.spk i{flex:1 1 0;background:currentColor;border-radius:1.5px 1.5px 0 0;opacity:.9;min-width:1px}
			.spk i:last-child{opacity:1}
			.bar{position:relative;height:clamp(4px,.4vw,7px);background:rgba(233,225,212,.7);border-radius:99px;margin-top:auto;overflow:hidden}
			.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:99px}
			.bar u{position:absolute;top:0;bottom:0;width:1.5px;background:#0E2A33;opacity:.5}
			</style>"
			
			VAR _html =
			    _css
			        & "<div class='ab' style=""grid-template-columns:repeat(5,1fr)"">"
			        & "<div class='t'><div class='lb'>OTIF</div>"
			            & "<div class='vl'" & " style='color:" & _c0 & "'" & ">" & FORMAT ( [OTIF %], "0.0%", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>on time e in full</em>" & "</div>"
			            & "<div class='bar'><i style='width:"
			            & FORMAT ( MIN ( MAX ( [OTIF %], 0 ), 1 ) / 1 * 100, "0.0", "en-US" )
			            & "%;background:" & _c0 & "'></i><u style='left:90.0%'></u></div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Lead Time Real</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Lead Time Real], "#,0.0", "pt-BR" ) & " d" & "</div>"
			            & "<div class='dt'" & ">" & "<em>previsto " & FORMAT([Lead Time Previsto],"#,0.0","pt-BR") & "d</em>" & "</div>"
			            & "<div class='spk' style='color:#17495A'>" & _pt1 & "</div>"
			            & "</div>"
			        & "<div class='t g'><div class='lb'>Embarques Atrasados</div>"
			            & "<div class='vl'" & " style='color:" & _c2 & "'" & ">" & FORMAT ( [% Embarques Atrasados], "0.0%", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>sobre entregas realizadas</em>" & "</div>"
			            & "<div class='spk' style='color:#8FA98F'>" & _pt2 & "</div>"
			            & "</div>"
			        & "<div class='t'><div class='lb'>Atraso Médio</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Dias de Atraso Medio], "#,0.0", "pt-BR" ) & " d" & "</div>"
			            & "<div class='dt'" & ">" & "<em>só embarques atrasados</em>" & "</div>"
			            & "</div>"
			        & "<div class='t b'><div class='lb'>Frete por Kg</div>"
			            & "<div class='vl'" & ">" & "US$ " & FORMAT ( [Frete por Kg], "#,0.00", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & ">" & "<em>frete / peso embarcado</em>" & "</div>"
			            & "<div class='spk' style='color:#17495A'>" & _pt4 & "</div>"
			            & "</div>"
			        & "</div>"
			RETURN
			    _html
		displayFolder: 17 Paineis HTML
		lineageTag: 42988d67-5ab3-c714-72ac-0bbd5002c5b2

	/// Painel de KPIs da pagina 09 Sales Team.
