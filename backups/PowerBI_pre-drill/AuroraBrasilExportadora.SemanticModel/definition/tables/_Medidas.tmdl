			            & "</div>"
			        & "<div class='t'><div class='lb'>Margem</div>"
			            & "<div class='vl'" & ">" & FORMAT ( [Margem Bruta %], "0.0%", "pt-BR" ) & "</div>"
			            & "<div class='dt'" & " style='color:" & _c3 & "'" & ">" & IF ( _d3 >= 0, "▲ ", "▼ " ) & FORMAT ( _d3, "0.0", "pt-BR" ) & " p.p. " & "<em>YoY</em>" & "</div>"
			            & "<div class='spk' style='color:#C8763C'>" & _pt3 & "</div>"
			            & "</div>"
			        & "</div>"
