			        ),
			        "@s0", CALCULATE ( [Receita USD] ),
			        "@s2", CALCULATE ( [Novos Clientes] ),
			        "@s3", CALCULATE ( [Margem Bruta %] )
			    )
			VAR _mn0 = MINX ( _serie, [@s0] )
			VAR _mx0 = MAXX ( _serie, [@s0] )
			VAR _pt0 =
			    CONCATENATEX (
