	measure 'Receita 12M' = [Receita Rolling 12M]
		formatString: "US$ "#,0.00
		displayFolder: 08 Potencial
		lineageTag: 4443a161-6d8d-328f-0c53-921ff2d79a16

	/// Receita dos ultimos 12 meses dividida pelo potencial anual estimado do cliente.
	measure 'Share of Wallet' = DIVIDE([Receita 12M], [Potencial Anual USD])
		formatString: #,0.0 %
		displayFolder: 08 Potencial
