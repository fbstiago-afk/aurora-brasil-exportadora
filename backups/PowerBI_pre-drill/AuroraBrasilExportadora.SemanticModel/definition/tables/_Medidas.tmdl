			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s0] - _mn0, _mx0 - _mn0, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
			        "",
			        dCalendario[AnoMesNumero], ASC
			    )
			VAR _mn2 = MINX ( _serie, [@s2] )
			VAR _mx2 = MAXX ( _serie, [@s2] )
			VAR _pt2 =
			    CONCATENATEX (
			        _serie,
			        "<i style='height:"
			            & FORMAT ( 12 + DIVIDE ( [@s2] - _mn2, _mx2 - _mn2, 0.5 ) * 88, "0", "en-US" )
			            & "%'></i>",
