VAR _css = "<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:transparent}
.g{height:100%;overflow-y:auto;font-family:'Segoe UI',system-ui,sans-serif;
   color:#16262C;padding:2px 6px 10px 2px}
.g::-webkit-scrollbar{width:7px}
.g::-webkit-scrollbar-thumb{background:rgba(14,42,51,.22);border-radius:99px}
.gh{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;
    border-left:4px solid #C8763C;padding:2px 0 2px 11px;margin-bottom:6px}
.gh h1{font-size:19px;font-weight:700;color:#0E2A33;letter-spacing:-.01em}
.gh span{font-size:10px;color:#8C96A5}
.hint{font-size:11.5px;color:#5D6E75;margin:0 0 13px 15px}
.hint b{color:#0E2A33}
details{background:rgba(255,255,255,.66);border:1px solid rgba(227,224,217,.85);
        border-radius:9px;margin-bottom:8px;overflow:hidden}
details[open]{background:rgba(255,255,255,.82);border-color:rgba(200,118,60,.45)}
summary{cursor:pointer;list-style:none;padding:9px 13px;
        display:flex;align-items:baseline;gap:11px;user-select:none}
summary::-webkit-details-marker{display:none}
summary::after{content:'+';margin-left:auto;font-size:15px;color:#C8763C;
               font-weight:700;line-height:1}
details[open] summary::after{content:'–'}
summary:hover{background:rgba(200,118,60,.07)}
.num{font-size:10px;font-weight:700;letter-spacing:.05em;color:#FFF;
     background:#0E2A33;border-radius:4px;padding:2px 7px;flex:none}
details[open] .num{background:#C8763C}
.tit{font-size:13px;font-weight:700;color:#0E2A33;flex:none}
.q{font-size:11.5px;color:#8C96A5;font-style:italic;
   overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.body{padding:2px 13px 12px;display:flex;flex-direction:column;gap:8px}
.v{display:grid;grid-template-columns:200px 1fr;gap:12px;align-items:baseline}
.v em{font-style:normal;font-size:11.5px;font-weight:600;color:#17495A}
.v p{font-size:11.5px;color:#5D6E75;line-height:1.55}
.sep{font-size:10px;letter-spacing:.08em;text-transform:uppercase;
     color:#8C96A5;font-weight:700;margin:15px 0 7px 2px}
.x{background:rgba(23,73,90,.06);border:1px solid rgba(227,224,217,.85);
   border-left:4px solid #C8763C;border-radius:8px;
   padding:10px 13px;margin-bottom:8px}
.x .tit{display:block;margin-bottom:3px}
.x .how{font-size:10px;color:#8C96A5;margin-bottom:6px}
.x p{font-size:11.5px;color:#5D6E75;line-height:1.55}
</style>"

VAR _html =
    _css
        & "<div class='g'>"
        & "<div class='gh'><h1>Guia de análise</h1><span>11 páginas · 4 dicas de ferramenta · 2 dossiês</span></div>"
        & "<div class='hint'>Clique em qualquer página para <b>expandir</b> o detalhe dos visuais e o que cada um permite analisar.</div>"
        & "<details><summary><span class='num'>01</span><span class='tit'>Executive Overview</span><span class='q'>Estamos crescendo, atingindo meta e preservando rentabilidade?</span></summary><div class='body'><div class='v'><em>Painel de 8 KPIs</em><p>Leitura de 3 segundos. As barras de 12 meses mostram se o número atual é ponto fora da curva ou tendência. A barra de Atingimento tem marca nos 100%: à esquerda dela, o ano está em risco.</p></div><div class='v'><em>Receita mensal: realizado x ano anterior x meta</em><p>Compare as três linhas. Realizado acima do ano anterior mas abaixo da meta significa que a meta subiu mais rápido que a operação.</p></div><div class='v'><em>Receita por mercado (mapa)</em><p>Concentração geográfica. Poucos países escuros = risco de dependência.</p></div><div class='v'><em>De onde veio a variação YoY (cascata)</em><p>Atribui o crescimento por continente. Serve para responder ""crescemos por quê"" — não é o mesmo que ""onde vendemos mais"".</p></div><div class='v'><em>Destaques por mercado</em><p>Cruza crescimento, margem e atingimento. Procure linhas com receita alta e margem baixa.</p></div></div></details>"
        & "<details><summary><span class='num'>02</span><span class='tit'>Sales Performance</span><span class='q'>O ritmo comercial está acima ou abaixo do compromisso assumido?</span></summary><div class='body'><div class='v'><em>Realizado mensal e atingimento acumulado</em><p>A coluna é o mês, a linha é o acumulado. A linha cruzando 100% no meio do ano indica meta subdimensionada.</p></div><div class='v'><em>Região comercial: realizado x meta</em><p>Barras pareadas. Região que bate meta com receita pequena pode ter meta frouxa.</p></div><div class='v'><em>Receita por executivo comercial</em><p>Ranking. Passe o mouse para ver a ficha do vendedor.</p></div><div class='v'><em>Decomposição por canal e categoria</em><p>A coluna Contribuição para Crescimento mostra quanto cada combinação puxou o total — não confunda com crescimento próprio.</p></div></div></details>"
        & "<details><summary><span class='num'>03</span><span class='tit'>Customers</span><span class='q'>Quem sustenta a receita, quem está escapando e quanto isso custa?</span></summary><div class='body'><div class='v'><em>Pareto de clientes</em><p>Barras por cliente e linha do acumulado. Onde a linha cruza 80% está sua dependência real.</p></div><div class='v'><em>Distribuição RFV da carteira</em><p>Campeões, Leais, Em Risco, Hibernando, Perdidos. Blocos grandes em Em Risco e Hibernando são receita ainda recuperável.</p></div><div class='v'><em>Receita por classe ABC</em><p>Concentração por valor. Compare com o RFV: classe A em situação Em Risco é a combinação mais cara.</p></div><div class='v'><em>Clientes ativos por porte</em><p>Série temporal por porte. Queda em um porte específico aponta problema de proposta, não de mercado.</p></div><div class='v'><em>Carteira detalhada</em><p>Ordene por Recência para achar risco: recência alta com receita alta é conta escapando.</p></div></div></details>"
        & "<details><summary><span class='num'>04</span><span class='tit'>Customer Potential</span><span class='q'>Onde existe receita não capturada e qual conta merece prioridade?</span></summary><div class='body'><div class='v'><em>Receita x Share of Wallet (dispersão)</em><p>O tamanho da bolha é o potencial. Bolha grande à esquerda = muito potencial, pouca penetração. É a região de maior retorno.</p></div><div class='v'><em>Ranking de oportunidade</em><p>O Score de Oportunidade pondera gap absoluto contra baixa penetração — prioriza quem tem espaço e ainda não foi trabalhado.</p></div><div class='v'><em>White space por segmento</em><p>Categorias que o segmento poderia comprar e não compra. Cruze com Penetração de Categorias.</p></div><div class='v'><em>Penetração por categoria</em><p>Quantos clientes compram cada categoria. Categoria com poucos compradores e margem boa é candidata a cross-sell.</p></div></div></details>"
        & "<details><summary><span class='num'>05</span><span class='tit'>Products</span><span class='q'>Qual portfólio cresce com rentabilidade e qual cresce destruindo margem?</span></summary><div class='body'><div class='v'><em>Matriz BCG adaptada</em><p>Crescimento no eixo x, margem no y, tamanho = receita. O quadrante inferior direito — cresce muito, margem baixa — é o que merece revisão de preço.</p></div><div class='v'><em>Receita e margem por categoria</em><p>Barras pareadas. Categoria com receita alta e margem em valor baixa está sendo vendida barato demais.</p></div><div class='v'><em>Evolução da margem por categoria</em><p>Tendência. Margem caindo de forma consistente indica erosão de preço, não sazonalidade.</p></div><div class='v'><em>Portfólio por SKU</em><p>Classe ABC e margem por quilo. Margem/kg é o indicador mais honesto num negócio de exportação por peso.</p></div></div></details>"
        & "<details><summary><span class='num'>06</span><span class='tit'>Markets</span><span class='q'>Quais mercados sustentam hoje e quais sustentarão os próximos anos?</span></summary><div class='body'><div class='v'><em>Market Opportunity Matrix</em><p>Crescimento x margem por país. O canto superior direito é onde investir; o inferior esquerdo, onde revisar a operação.</p></div><div class='v'><em>Distribuição global (mapa)</em><p>Leitura geográfica da concentração.</p></div><div class='v'><em>Ranking de mercados</em><p>Ordem por receita. Passe o mouse para OTIF, lead time e frete do país.</p></div><div class='v'><em>Mercado x categoria</em><p>Cruza continente e categoria com lead time. Combinação de margem boa e lead time alto é candidata a revisar logística, não preço.</p></div></div></details>"
        & "<details><summary><span class='num'>07</span><span class='tit'>Profitability</span><span class='q'>Entre a receita bruta e a margem, onde o valor está sendo consumido?</span></summary><div class='body'><div class='v'><em>Ponte econômica detalhada</em><p>Da receita bruta à margem, coluna a coluna: descontos, custo de produto, frete, seguro, despesas. É o mapa completo do consumo de valor.</p></div><div class='v'><em>Formação da margem por categoria (cascata)</em><p>Quanto cada categoria adiciona ou subtrai da margem total.</p></div><div class='v'><em>Cliente: receita x margem</em><p>Dispersão. Clientes grandes e de margem baixa aparecem à direita e embaixo — são os que mais pesam na média.</p></div><div class='v'><em>Rentabilidade por vendedor e Incoterm</em><p>Frete % Receita e Desconto % lado a lado revelam se a margem cai por concessão comercial ou por estrutura logística.</p></div></div></details>"
        & "<details><summary><span class='num'>08</span><span class='tit'>Logistics</span><span class='q'>Onde a operação perde prazo e quanto isso custa por quilo?</span></summary><div class='body'><div class='v'><em>Painel com OTIF</em><p>A barra de OTIF tem marca nos 90%. Abaixo disso, o problema é sistêmico, não pontual.</p></div><div class='v'><em>Lead time real x previsto</em><p>Duas linhas. Gap constante significa previsão mal calibrada; gap crescente significa degradação real.</p></div><div class='v'><em>Motivos de atraso</em><p>Pareto dos motivos. Concentre esforço nos dois primeiros.</p></div><div class='v'><em>Rotas com maior incidência</em><p>Percentual de atraso por país de destino. Cruze com o volume: 40% de atraso numa rota pequena importa menos.</p></div><div class='v'><em>Performance por transportadora</em><p>OTIF por operador. Base de renegociação contratual.</p></div><div class='v'><em>Modal e porto de origem</em><p>Frete por quilo por combinação. Modal aéreo com frete/kg fora da curva pode indicar uso emergencial.</p></div></div></details>"
        & "<details><summary><span class='num'>09</span><span class='tit'>Sales Team</span><span class='q'>Quem entrega, quem depende de um único cliente e quem precisa de apoio?</span></summary><div class='body'><div class='v'><em>Quadrante: crescimento x atingimento</em><p>Cresce e bate meta (manter), cresce e não bate (meta agressiva), não cresce e bate (meta frouxa), nenhum dos dois (agir).</p></div><div class='v'><em>Realizado x meta por vendedor</em><p>Barras pareadas para a leitura direta do gap.</p></div><div class='v'><em>Dependência do maior cliente</em><p>Risco de carteira. Acima de 40% num único cliente, a saída dele derruba o vendedor — e o número não aparece em nenhum outro visual.</p></div><div class='v'><em>Ranking comercial</em><p>Consolidado com gap e clientes ativos.</p></div></div></details>"
        & "<details><summary><span class='num'>10</span><span class='tit'>Finance</span><span class='q'>Quanto do faturamento ainda não virou caixa e qual cliente trava o ciclo?</span></summary><div class='body'><div class='v'><em>Aging da carteira</em><p>Faixas de vencimento. O peso nas faixas acima de 90 dias é o que dificilmente se recupera.</p></div><div class='v'><em>Situação dos títulos</em><p>Pago, Pago em atraso, Parcial, Vencido, Em aberto. ""Pago em atraso"" não é inadimplência, mas é custo de capital de giro.</p></div><div class='v'><em>Saldo vencido por forma de pagamento</em><p>Identifica se a inadimplência está concentrada num instrumento — o que é problema de política, não de cliente.</p></div><div class='v'><em>Principais devedores</em><p>Dias médios de atraso e prazo médio por conta. Cruze com a página Customers: devedor que também é Campeão RFV pede negociação, não cobrança.</p></div></div></details>"
        & "<details><summary><span class='num'>11</span><span class='tit'>Forecast e Budget</span><span class='q'>Se a tendência continuar, fechamos o ano acima ou abaixo do compromisso?</span></summary><div class='body'><div class='v'><em>Linha temporal: realizado, orçado, forecast e meta</em><p>Quatro séries. O ponto onde forecast e meta divergem é a data em que a decisão precisa ser tomada.</p></div><div class='v'><em>Peso histórico de cada mês</em><p>Sazonalidade. Base para julgar se um mês fraco é problema ou calendário.</p></div><div class='v'><em>Realizado x orçado x forecast por região</em><p>Actual vs Budget por região e categoria, para saber onde o desvio se origina.</p></div></div></details>"
        & "<div class='sep'>Além das páginas</div>"
        & "<div class='x'><span class='tit'>Dicas de ferramenta</span><div class='how'>4 páginas de tooltip em HTML, acionadas ao passar o mouse</div><p>Cliente, Produto, Mercado e Vendedor. Cada uma traz identificação, 4 KPIs, barras de 12 meses e duas comparações específicas — margem alvo no produto, concentração de carteira no vendedor, OTIF no mercado. Escolha ditada pela dimensão que o visual agrupa, não pela página.</p></div>"
        & "<div class='x'><span class='tit'>Detalhe Cliente e Detalhe Mercado</span><div class='how'>Páginas de drill-through, botão direito sobre o item</div><p>Dossiê de página inteira do item selecionado: KPIs, histórico mensal, mix e detalhe tabular. O botão Voltar retorna à página de origem exata. Use quando a pergunta deixa de ser ""como isso se compara"" e vira ""o que está acontecendo aqui"".</p></div>"
        & "</div>"
RETURN
    _html
