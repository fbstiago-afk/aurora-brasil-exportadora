			column: Data

	partition dCalendario = m
		mode: import
		source =
				let
				    Origem = Csv.Document(
				        File.Contents(pBasePath & "dCalendario.csv"),
				        [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    CabecalhoPromovido = Table.PromoteHeaders(Origem, [PromoteAllScalars = true]),
				    TiposAplicados = Table.TransformColumnTypes(
				        CabecalhoPromovido,
				        {{"Data", type date},{"Ano", Int64.Type},{"Trimestre", type text},{"NumeroMes", Int64.Type},{"Mes", Int64.Type},{"MesAbreviado", type text},{"AnoMes", type text},{"AnoMesNumero", Int64.Type},{"SemanaAno", Int64.Type},{"NumeroDiaSemana", Int64.Type},{"DiaSemana", type text},{"FimDeSemana", type text},{"DiaUtil", type text},{"InicioMes", type date},{"FimMes", type date}},
				        "pt-BR"
				    ),
				    ErrosTratados = Table.ReplaceErrorValues(
				        TiposAplicados,
				        List.Transform(Table.ColumnNames(TiposAplicados), each {_, null})
				    )
				in
				    ErrosTratados

	annotation PBI_ResultType = Table

